---
/** Case highlight on industry pages: photo, client, summary and a link to the
 *  full case at /casos-de-exito/<id>. Case content and assets belong to the catalog. */
import Icon from '../ds/Icon.astro';
import type { Caso } from '../../data/casos-destacados';
import { casePath, i18n } from '../../i18n';

interface Props {
  caso: Caso;
  imageSide?: 'left' | 'right';
}

const { caso, imageSide = 'left' } = Astro.props;
const { lang, t } = i18n(Astro.url);
const { items, kicker } = caso.aside;
const itemIcon = items.length > 1 ? 'check' : 'info';
---

<article
  data-case-id={caso.id}
  class:list={['ind-case', imageSide === 'right' && 'ind-case--image-right']}
>
  <div class="ind-case__photo" style={`background-image:url(${caso.image})`} aria-hidden="true" />
  <div class="ind-case__body">
    <img
      class="ind-case__logo"
      src={caso.client.logo.src}
      alt={caso.client.logo.alt}
      style={`height:${caso.client.logo.height}px`}
      loading="lazy"
    />
    <span class="ind-kicker">{t('cases.featured')}</span>
    <h2 class="ind-case__title">{`${caso.client.name}: ${caso.project}`}</h2>
    <p class="ind-case__text">{caso.summary}</p>
    {
      items.length > 0 && (
        <div class="ind-case__details">
          <ul class="ind-case__list" aria-label={kicker}>
            {items.map((item) => (
              <li>
                <Icon name={itemIcon} size={20} />
                {item}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <a class="ind-case__link" href={casePath(caso.id, lang)}>{t('cases.viewFull')}</a>
  </div>
</article>
