---
/** Contact form shared by the home page and /contacto. It posts to n8n from
 *  the browser; credentials stay server-side. Consenty handles Turnstile when enabled. */
import Button from '../ds/Button.astro';
import Field from '../ds/Field.astro';
import { contactReasonOptions, industryOptions, site } from '../../data/site';

interface Props {
  rows?: number;
}

const { rows = 4 } = Astro.props;
---

<form
  class="contact__form"
  action={site.contactAction}
  method={site.contactAction ? 'post' : undefined}
  data-contact-form
  data-endpoint={site.contactAction}
  data-consenty-integration={site.consentyIntegrationId}
  data-consenty-tenant={site.consentyTenant}
  data-consenty-sdk={site.consentySdkUrl}
>
  <div class="contact__fields">
    <Field
      name="nombre"
      label="Nombre"
      placeholder="Tu nombre"
      autocomplete="given-name"
      maxlength={100}
      required
    />
    <Field
      name="apellido"
      label="Apellido"
      placeholder="Tu apellido"
      autocomplete="family-name"
      maxlength={100}
      required
    />
    <Field
      name="empresa"
      label="Empresa (opcional)"
      placeholder="Nombre de tu empresa"
      autocomplete="organization"
      maxlength={160}
    />
    <Field
      name="cargo"
      label="Cargo (opcional)"
      placeholder="Tu cargo"
      autocomplete="organization-title"
      maxlength={120}
    />
    <Field
      name="email"
      label={site.consentyIntegrationId ? 'Email' : 'Email (opcional)'}
      type="email"
      placeholder="nombre@empresa.com"
      autocomplete="email"
      maxlength={254}
    />
    <Field
      name="telefono"
      label="Teléfono (opcional)"
      type="tel"
      placeholder="+56 9 …"
      autocomplete="tel"
      maxlength={30}
    />
    <p class="contact__field-note">{site.consentyIntegrationId ? 'Consenty verificará tu correo antes del envío. Si no lo ingresas aquí, lo solicitará junto con tu RUT.' : 'Ingresa al menos un medio de contacto: email o teléfono.'}</p>
    <Field
      as="select"
      name="industria"
      label="Industria (opcional)"
      placeholder="Selecciona una industria"
      options={industryOptions}
    />
    <Field
      as="select"
      name="motivo"
      label="Motivo"
      placeholder="Selecciona un motivo"
      options={contactReasonOptions}
      required
    />
  </div>

  <Field
    as="textarea"
    name="mensaje"
    label="Mensaje o desafío"
    rows={rows}
    placeholder="Cuéntanos brevemente tu desafío"
    maxlength={4000}
    required
  />

  {!site.consentyIntegrationId && <Field as="checkbox" name="consent" required>
    Acepto el tratamiento de mis datos personales para responder esta solicitud, conforme a la
    <a href="/privacidad">política de privacidad</a>.
  </Field>}

  {site.consentyIntegrationId && <div data-consenty-container><p>Verificación y preferencias de privacidad con Consenty.</p></div>}

  {site.consentyIntegrationId && <p class="contact__field-note">
    Consulta nuestra <a href="/privacidad">política de privacidad</a> antes de enviar.
    No incluyas datos sensibles ni datos de terceros sin autorización.
    Si prefieres no usar Consenty o tienes problemas con el formulario,
    escríbenos a <a href="mailto:contacto@japs.ing">contacto@japs.ing</a>.
  </p>}

  <div class="contact__honeypot" aria-hidden="true">
    <label for="f-website">Sitio web</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    !site.consentyIntegrationId && site.turnstileSiteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={site.turnstileSiteKey}
        data-action="contact_form"
        data-theme="light"
      />
    )
  }

  <div class="contact__submit">
    <Button variant="primary" type="submit">
      <span data-submit-label>Enviar mensaje</span>
    </Button>
    <p class="contact__status" data-form-status aria-live="polite"></p>
  </div>

  <noscript>
    <p class="contact__status contact__status--error">
      Necesitas JavaScript habilitado para verificar y enviar el formulario.
    </p>
  </noscript>
</form>

{
  !site.consentyIntegrationId && site.turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  interface TurnstileApi {
    reset: () => void;
  }

  interface ConsentyHandle {
    prepareSubmission: (input: { submissionId: string }) => Promise<{ token: string; email: string }>;
    reset: () => void;
  }

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
      ConsentyWidget?: { mount: (container: HTMLElement, options: { tenantSlug: string; integrationId: string; form: HTMLFormElement }) => ConsentyHandle };
    }
  }

  let sdkLoading: Promise<void> | undefined;
  function loadSdk(url: string): Promise<void> {
    if (window.ConsentyWidget) return Promise.resolve();
    if (sdkLoading) return sdkLoading;
    sdkLoading = new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = url;
      script.async = true;
      const timer = setTimeout(() => reject(new Error('Consenty no está disponible. Intenta nuevamente.')), 15000);
      script.onload = () => { clearTimeout(timer); if (window.ConsentyWidget) resolve(); else reject(new Error('No se pudo iniciar Consenty.')); };
      script.onerror = () => { clearTimeout(timer); reject(new Error('No se pudo cargar Consenty.')); };
      document.head.appendChild(script);
    }).catch((error: unknown) => { sdkLoading = undefined; throw error; });
    return sdkLoading;
  }

  const newSubmissionId = () =>
    globalThis.crypto?.randomUUID?.() ??
    `${Date.now()}-${Math.random().toString(16).slice(2)}-${Math.random().toString(16).slice(2)}`;

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const endpoint = form.dataset.endpoint;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
    const phoneInput = form.elements.namedItem('telefono') as HTMLInputElement | null;
    let submissionId = newSubmissionId();
    const integrationId = form.dataset.consentyIntegration;
    let widget: ConsentyHandle | undefined;
    let proof: { token: string; email: string } | undefined;
    let sending = false;
    let revision = 0;
    const mountWidget = async () => {
      if (!integrationId || widget) return;
      await loadSdk(form.dataset.consentySdk!);
      widget = window.ConsentyWidget!.mount(form.querySelector<HTMLElement>('[data-consenty-container]')!, {
        tenantSlug: form.dataset.consentyTenant!, integrationId, form,
      });
    };
    if (integrationId) void mountWidget().catch(() => setStatus('Consenty no está disponible. Puedes reintentar al enviar.', 'error'));
    form.addEventListener('input', () => {
      revision += 1;
      if (proof) submissionId = newSubmissionId();
      proof = undefined;
    });

    const validateContactMethod = () => {
      const hasContactMethod = Boolean(integrationId || emailInput?.value.trim() || phoneInput?.value.trim());
      emailInput?.setCustomValidity(
        hasContactMethod ? '' : 'Ingresa al menos un email o un teléfono.',
      );
      return hasContactMethod;
    };

    emailInput?.addEventListener('input', validateContactMethod);
    phoneInput?.addEventListener('input', validateContactMethod);

    const setStatus = (message: string, kind?: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('contact__status--success', kind === 'success');
      status.classList.toggle('contact__status--error', kind === 'error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      validateContactMethod();
      if (!form.reportValidity()) return;
      if (!endpoint) {
        setStatus('El formulario aún no está configurado. Escríbenos a contacto@japs.ing.', 'error');
        return;
      }

      const data = new FormData(form);
      const turnstileToken = data.get('cf-turnstile-response');
      if (!integrationId && !turnstileToken) {
        setStatus('Completa la verificación de seguridad antes de enviar.', 'error');
        return;
      }

      const payload = new URLSearchParams();
      data.forEach((value, key) => {
        if (typeof value === 'string') payload.append(key, value);
      });
      payload.set('submissionId', submissionId);
      payload.set('sourcePath', window.location.pathname);
      payload.set('consent', data.has('consent') ? 'true' : 'false');

      button?.setAttribute('disabled', '');
      sending = true;
      const submittedRevision = revision;
      if (buttonLabel) buttonLabel.textContent = 'Enviando…';
      setStatus('Enviando tu mensaje…');

      try {
        if (integrationId) {
          await mountWidget();
          proof ??= await widget!.prepareSubmission({ submissionId });
          if (revision !== submittedRevision) {
            proof = undefined;
            throw new Error('El formulario cambió. Revisa los datos y vuelve a enviar.');
          }
          payload.set('consentyToken', proof.token);
          payload.set('consentyIntegrationId', integrationId);
          payload.set('email', proof.email);
          payload.delete('consent');
          payload.delete('cf-turnstile-response');
        }
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: payload,
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) {
          if (response.status === 403) {
            throw new Error('No pudimos completar la verificación de seguridad. Intenta nuevamente.');
          }
          if (response.status === 422) {
            proof = undefined;
            throw new Error('Revisa los datos ingresados e intenta nuevamente.');
          }
          throw new Error('No pudimos guardar tu mensaje. Intenta nuevamente en unos minutos.');
        }

        form.reset();
        emailInput?.setCustomValidity('');
        submissionId = newSubmissionId();
        proof = undefined;
        widget?.reset();
        if (!integrationId) window.turnstile?.reset();
        setStatus('Gracias. Recibimos tu mensaje y te responderemos dentro de un día hábil.', 'success');
      } catch (error) {
        if (!integrationId) window.turnstile?.reset();
        setStatus(
          error instanceof Error
            ? error.message
            : 'No pudimos enviar tu mensaje. Intenta nuevamente.',
          'error',
        );
      } finally {
        sending = false;
        button?.removeAttribute('disabled');
        if (buttonLabel) buttonLabel.textContent = 'Enviar mensaje';
      }
    });
  });
</script>
