---
/** Contact form shared by the home page and /contacto. It posts to n8n from
 *  the browser; credentials stay server-side. Consenty handles Turnstile when enabled. */
import Button from '../ds/Button.astro';
import Field from '../ds/Field.astro';
import { contactReasonOptions, industryOptions, optionsFor } from '../../data/contactOptions';
import { site } from '../../data/site';
import { i18n } from '../../i18n';

interface Props {
  rows?: number;
}

const { rows = 4 } = Astro.props;
const { lang, t, p } = i18n(Astro.url);

/* Los mensajes del script salen del mismo diccionario que el resto del
   formulario; viajan como JSON en un data-attribute porque el <script> de
   Astro se empaqueta una vez para todas las páginas. */
const messages = {
  sdkUnavailable: t('form.msg.sdkUnavailable'),
  sdkInit: t('form.msg.sdkInit'),
  sdkLoad: t('form.msg.sdkLoad'),
  sdkRetry: t('form.msg.sdkRetry'),
  contactMethod: t('form.msg.contactMethod'),
  notConfigured: t('form.msg.notConfigured'),
  security: t('form.msg.security'),
  sending: t('form.msg.sending'),
  sendingStatus: t('form.msg.sendingStatus'),
  changed: t('form.msg.changed'),
  verifyFailed: t('form.msg.verifyFailed'),
  reviewData: t('form.msg.reviewData'),
  saveFailed: t('form.msg.saveFailed'),
  success: t('form.msg.success'),
  sendFailed: t('form.msg.sendFailed'),
  submit: t('form.submit'),
};
---

<form
  class="contact__form"
  action={site.contactAction}
  method={site.contactAction ? 'post' : undefined}
  data-contact-form
  data-endpoint={site.contactAction}
  data-consenty-integration={site.consentyIntegrationId}
  data-consenty-tenant={site.consentyTenant}
  data-consenty-sdk={site.consentySdkUrl}
  data-messages={JSON.stringify(messages)}
  data-lang={lang}
>
  <div class="contact__fields">
    <Field
      name="nombre"
      label={t('form.firstName')}
      placeholder={t('form.firstNamePh')}
      autocomplete="given-name"
      maxlength={100}
      required
    />
    <Field
      name="apellido"
      label={t('form.lastName')}
      placeholder={t('form.lastNamePh')}
      autocomplete="family-name"
      maxlength={100}
      required
    />
    <Field
      name="empresa"
      label={t('form.company')}
      placeholder={t('form.companyPh')}
      autocomplete="organization"
      maxlength={160}
    />
    <Field
      name="cargo"
      label={t('form.jobTitle')}
      placeholder={t('form.jobTitlePh')}
      autocomplete="organization-title"
      maxlength={120}
    />
    <Field
      name="email"
      label={site.consentyIntegrationId ? t('form.email') : t('form.emailOptional')}
      type="email"
      placeholder={t('form.emailPh')}
      autocomplete="email"
      maxlength={254}
    />
    <Field
      name="telefono"
      label={t('form.phone')}
      type="tel"
      placeholder={t('form.phonePh')}
      autocomplete="tel"
      maxlength={30}
    />
    <p class="contact__field-note">{site.consentyIntegrationId ? t('form.noteConsenty') : t('form.noteContact')}</p>
    <Field
      as="select"
      name="industria"
      label={t('form.industry')}
      placeholder={t('form.industryPh')}
      options={optionsFor(industryOptions, lang)}
    />
    <Field
      as="select"
      name="motivo"
      label={t('form.reason')}
      placeholder={t('form.reasonPh')}
      options={optionsFor(contactReasonOptions, lang)}
      required
    />
  </div>

  <Field
    as="textarea"
    name="mensaje"
    label={t('form.message')}
    rows={rows}
    placeholder={t('form.messagePh')}
    maxlength={4000}
    required
  />

  {!site.consentyIntegrationId && <Field as="checkbox" name="consent" required>
    {t('form.consentPre')}{' '}
    <a href={p('privacy')}>{t('form.consentLink')}</a>{t('form.consentPost')}
  </Field>}

  {site.consentyIntegrationId && <div data-consenty-container><p>{t('form.consentyWidget')}</p></div>}

  {site.consentyIntegrationId && <p class="contact__field-note">
    {t('form.consentyNote1')} <a href={p('privacy')}>{t('form.consentLink')}</a> {t('form.consentyNote2')}{' '}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>}

  <div class="contact__honeypot" aria-hidden="true">
    <label for="f-website">{t('form.website')}</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    !site.consentyIntegrationId && site.turnstileSiteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={site.turnstileSiteKey}
        data-action="contact_form"
        data-theme="light"
      />
    )
  }

  <div class="contact__submit">
    <Button variant="primary" type="submit">
      <span data-submit-label>{t('form.submit')}</span>
    </Button>
    <p class="contact__status" data-form-status aria-live="polite"></p>
  </div>

  <noscript>
    <p class="contact__status contact__status--error">{t('form.noscript')}</p>
  </noscript>
</form>

{
  !site.consentyIntegrationId && site.turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  interface TurnstileApi {
    reset: () => void;
  }

  interface ConsentyHandle {
    prepareSubmission: (input: { submissionId: string }) => Promise<{ token: string; email: string }>;
    reset: () => void;
  }

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
      ConsentyWidget?: { mount: (container: HTMLElement, options: { tenantSlug: string; integrationId: string; form: HTMLFormElement }) => ConsentyHandle };
    }
  }

  type Messages = Record<
    | 'sdkUnavailable' | 'sdkInit' | 'sdkLoad' | 'sdkRetry' | 'contactMethod' | 'notConfigured'
    | 'security' | 'sending' | 'sendingStatus' | 'changed' | 'verifyFailed' | 'reviewData'
    | 'saveFailed' | 'success' | 'sendFailed' | 'submit',
    string
  >;

  let sdkLoading: Promise<void> | undefined;
  function loadSdk(url: string, M: Messages): Promise<void> {
    if (window.ConsentyWidget) return Promise.resolve();
    if (sdkLoading) return sdkLoading;
    sdkLoading = new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = url;
      script.async = true;
      const timer = setTimeout(() => reject(new Error(M.sdkUnavailable)), 15000);
      script.onload = () => { clearTimeout(timer); if (window.ConsentyWidget) resolve(); else reject(new Error(M.sdkInit)); };
      script.onerror = () => { clearTimeout(timer); reject(new Error(M.sdkLoad)); };
      document.head.appendChild(script);
    }).catch((error: unknown) => { sdkLoading = undefined; throw error; });
    return sdkLoading;
  }

  const newSubmissionId = () =>
    globalThis.crypto?.randomUUID?.() ??
    `${Date.now()}-${Math.random().toString(16).slice(2)}-${Math.random().toString(16).slice(2)}`;

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const M = JSON.parse(form.dataset.messages ?? '{}') as Messages;
    const endpoint = form.dataset.endpoint;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
    const phoneInput = form.elements.namedItem('telefono') as HTMLInputElement | null;
    let submissionId = newSubmissionId();
    const integrationId = form.dataset.consentyIntegration;
    let widget: ConsentyHandle | undefined;
    let proof: { token: string; email: string } | undefined;
    let sending = false;
    let revision = 0;
    const mountWidget = async () => {
      if (!integrationId || widget) return;
      await loadSdk(form.dataset.consentySdk!, M);
      widget = window.ConsentyWidget!.mount(form.querySelector<HTMLElement>('[data-consenty-container]')!, {
        tenantSlug: form.dataset.consentyTenant!, integrationId, form,
      });
    };
    if (integrationId) void mountWidget().catch(() => setStatus(M.sdkRetry, 'error'));
    form.addEventListener('input', () => {
      revision += 1;
      if (proof) submissionId = newSubmissionId();
      proof = undefined;
    });

    const validateContactMethod = () => {
      const hasContactMethod = Boolean(integrationId || emailInput?.value.trim() || phoneInput?.value.trim());
      emailInput?.setCustomValidity(
        hasContactMethod ? '' : M.contactMethod,
      );
      return hasContactMethod;
    };

    emailInput?.addEventListener('input', validateContactMethod);
    phoneInput?.addEventListener('input', validateContactMethod);

    const setStatus = (message: string, kind?: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('contact__status--success', kind === 'success');
      status.classList.toggle('contact__status--error', kind === 'error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      validateContactMethod();
      if (!form.reportValidity()) return;
      if (!endpoint) {
        setStatus(M.notConfigured, 'error');
        return;
      }

      const data = new FormData(form);
      const turnstileToken = data.get('cf-turnstile-response');
      if (!integrationId && !turnstileToken) {
        setStatus(M.security, 'error');
        return;
      }

      const payload = new URLSearchParams();
      data.forEach((value, key) => {
        if (typeof value === 'string') payload.append(key, value);
      });
      payload.set('submissionId', submissionId);
      payload.set('sourcePath', window.location.pathname);
      payload.set('consent', data.has('consent') ? 'true' : 'false');
      payload.set('lang', form.dataset.lang ?? document.documentElement.lang);

      button?.setAttribute('disabled', '');
      sending = true;
      const submittedRevision = revision;
      if (buttonLabel) buttonLabel.textContent = M.sending;
      setStatus(M.sendingStatus);

      try {
        if (integrationId) {
          await mountWidget();
          proof ??= await widget!.prepareSubmission({ submissionId });
          if (revision !== submittedRevision) {
            proof = undefined;
            throw new Error(M.changed);
          }
          payload.set('consentyToken', proof.token);
          payload.set('consentyIntegrationId', integrationId);
          payload.set('email', proof.email);
          payload.delete('consent');
          payload.delete('cf-turnstile-response');
        }
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: payload,
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) {
          if (response.status === 403) {
            throw new Error(M.verifyFailed);
          }
          if (response.status === 422) {
            proof = undefined;
            throw new Error(M.reviewData);
          }
          throw new Error(M.saveFailed);
        }

        form.reset();
        emailInput?.setCustomValidity('');
        submissionId = newSubmissionId();
        proof = undefined;
        widget?.reset();
        if (!integrationId) window.turnstile?.reset();
        setStatus(M.success, 'success');
      } catch (error) {
        if (!integrationId) window.turnstile?.reset();
        setStatus(
          error instanceof Error
            ? error.message
            : M.sendFailed,
          'error',
        );
      } finally {
        sending = false;
        button?.removeAttribute('disabled');
        if (buttonLabel) buttonLabel.textContent = M.submit;
      }
    });
  });
</script>
