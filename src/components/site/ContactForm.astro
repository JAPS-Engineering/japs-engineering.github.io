---
/** Contact form shared by the home page and /contacto. It posts to n8n from
 *  the browser behind Cloudflare Turnstile; credentials stay server-side. */
import Button from '../ds/Button.astro';
import Field from '../ds/Field.astro';
import { contactReasonOptions, industryOptions, optionsFor } from '../../data/contactOptions';
import { site } from '../../data/site';
import { i18n } from '../../i18n';

interface Props {
  rows?: number;
  /** `page` (/contacto): motivo as icon tiles, industria as pills, an icon in
   *  every field and a `head` slot. `default` (home) keeps the two selects. */
  variant?: 'default' | 'page';
}

const { rows = 4, variant = 'default' } = Astro.props;
const isPage = variant === 'page';
const ic = (name: string) => (isPage ? name : undefined);
const { lang, t, p } = i18n(Astro.url);
/* "Industria (opcional)" → ["…", "Industria", "(opcional)"], same split Field does. */
const industryLabel = t('form.industry').match(/^(.*?)\s(\(.*\))$/) ?? ['', t('form.industry'), ''];

/* Los mensajes del script salen del mismo diccionario que el resto del
   formulario; viajan como JSON en un data-attribute porque el <script> de
   Astro se empaqueta una vez para todas las páginas. */
const messages = {
  contactMethod: t('form.msg.contactMethod'),
  notConfigured: t('form.msg.notConfigured'),
  security: t('form.msg.security'),
  sending: t('form.msg.sending'),
  sendingStatus: t('form.msg.sendingStatus'),
  verifyFailed: t('form.msg.verifyFailed'),
  reviewData: t('form.msg.reviewData'),
  saveFailed: t('form.msg.saveFailed'),
  success: t('form.msg.success'),
  sendFailed: t('form.msg.sendFailed'),
  submit: t('form.submit'),
};
---

<form
  class:list={['contact__form', isPage && 'contact-form--page']}
  action={site.contactAction}
  method={site.contactAction ? 'post' : undefined}
  data-contact-form
  data-endpoint={site.contactAction}
  data-messages={JSON.stringify(messages)}
  data-lang={lang}
>
  {isPage && <slot name="head" />}

  {
    isPage && (
      <fieldset class="choice-group">
        <legend class="field__label">{t('form.reason')}</legend>
        <div class="motive-grid">
          {contactReasonOptions.map((option) => (
            <label class="motive-tile">
              <input type="radio" name="motivo" value={option.value} required />
              <span class="ms-icon" aria-hidden="true">{option.icon}</span>
              <b>{option.label[lang]}</b>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <div class="contact__fields">
    <Field
      name="nombre"
      icon={ic('person')}
      label={t('form.firstName')}
      placeholder={t('form.firstNamePh')}
      autocomplete="given-name"
      maxlength={100}
      required
    />
    <Field
      name="apellido"
      icon={ic('badge')}
      label={t('form.lastName')}
      placeholder={t('form.lastNamePh')}
      autocomplete="family-name"
      maxlength={100}
      required
    />
    <Field
      name="empresa"
      icon={ic('apartment')}
      label={t('form.company')}
      placeholder={t('form.companyPh')}
      autocomplete="organization"
      maxlength={160}
    />
    <Field
      name="cargo"
      icon={ic('work')}
      label={t('form.jobTitle')}
      placeholder={t('form.jobTitlePh')}
      autocomplete="organization-title"
      maxlength={120}
    />
    <Field
      name="email"
      icon={ic('mail')}
      label={t('form.emailOptional')}
      type="email"
      placeholder={t('form.emailPh')}
      autocomplete="email"
      maxlength={254}
    />
    <Field
      name="telefono"
      icon={ic('call')}
      label={t('form.phone')}
      type="tel"
      placeholder={t('form.phonePh')}
      autocomplete="tel"
      maxlength={30}
    />
    <p class="contact__field-note">
      {isPage && <span class="ms-icon" aria-hidden="true">info</span>}
      {t('form.noteContact')}
    </p>
    {
      !isPage && (
        <>
        <Field
          as="select"
          name="industria"
          label={t('form.industry')}
          placeholder={t('form.industryPh')}
          options={optionsFor(industryOptions, lang)}
        />
        <Field
          as="select"
          name="motivo"
          label={t('form.reason')}
          placeholder={t('form.reasonPh')}
          options={optionsFor(contactReasonOptions, lang)}
          required
        />
        </>
      )
    }
  </div>

  {
    isPage && (
      <fieldset class="choice-group">
        <legend class="field__label">
          {industryLabel[1]}{' '}<span class="field__optional">{industryLabel[2]}</span>
        </legend>
        <div class="choice-pills">
          {industryOptions.map((option) => (
            <label class:list={['choice-pill', option.tone && `ind-tone--${option.tone}`]}>
              <input type="radio" name="industria" value={option.value} />
              <span class="ms-icon" aria-hidden="true">{option.icon}</span>
              {option.label[lang]}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <Field
    as="textarea"
    name="mensaje"
    icon={ic('edit_note')}
    label={t('form.message')}
    rows={rows}
    placeholder={t('form.messagePh')}
    maxlength={4000}
    required
  />

  <Field as="checkbox" name="consent" required>
    {t('form.consentPre')}{' '}
    <a href={p('privacy')}>{t('form.consentLink')}</a>{t('form.consentPost')}
  </Field>

  <div class="contact__honeypot" aria-hidden="true">
    <label for="f-website">{t('form.website')}</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    site.turnstileSiteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={site.turnstileSiteKey}
        data-action="contact_form"
        data-theme="light"
      />
    )
  }

  <div class="contact__submit">
    <Button variant="primary" type="submit">
      <span data-submit-label>{t('form.submit')}</span>
      {isPage && <span class="ms-icon" aria-hidden="true">send</span>}
    </Button>
    {
      isPage && (
        <span class="contact__reply">
          <span class="ms-icon" aria-hidden="true">schedule</span>
          {t('form.replyTime')}
        </span>
      )
    }
    <p class="contact__status" data-form-status aria-live="polite"></p>
  </div>

  <noscript>
    <p class="contact__status contact__status--error">{t('form.noscript')}</p>
  </noscript>
</form>

{
  site.turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  interface TurnstileApi {
    reset: () => void;
  }

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
    }
  }

  type Messages = Record<
    | 'contactMethod' | 'notConfigured' | 'security' | 'sending' | 'sendingStatus'
    | 'verifyFailed' | 'reviewData' | 'saveFailed' | 'success' | 'sendFailed' | 'submit',
    string
  >;

  const newSubmissionId = () =>
    globalThis.crypto?.randomUUID?.() ??
    `${Date.now()}-${Math.random().toString(16).slice(2)}-${Math.random().toString(16).slice(2)}`;

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const M = JSON.parse(form.dataset.messages ?? '{}') as Messages;
    const endpoint = form.dataset.endpoint;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
    const phoneInput = form.elements.namedItem('telefono') as HTMLInputElement | null;
    let submissionId = newSubmissionId();
    let sending = false;

    const validateContactMethod = () => {
      const hasContactMethod = Boolean(emailInput?.value.trim() || phoneInput?.value.trim());
      emailInput?.setCustomValidity(
        hasContactMethod ? '' : M.contactMethod,
      );
      return hasContactMethod;
    };

    emailInput?.addEventListener('input', validateContactMethod);
    phoneInput?.addEventListener('input', validateContactMethod);

    const setStatus = (message: string, kind?: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('contact__status--success', kind === 'success');
      status.classList.toggle('contact__status--error', kind === 'error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      validateContactMethod();
      if (!form.reportValidity()) return;
      if (!endpoint) {
        setStatus(M.notConfigured, 'error');
        return;
      }

      const data = new FormData(form);
      if (!data.get('cf-turnstile-response')) {
        setStatus(M.security, 'error');
        return;
      }

      const payload = new URLSearchParams();
      data.forEach((value, key) => {
        if (typeof value === 'string') payload.append(key, value);
      });
      // The industria pills are optional radios: send the key empty, as the select does.
      if (!payload.has('industria')) payload.set('industria', '');
      payload.set('submissionId', submissionId);
      payload.set('sourcePath', window.location.pathname);
      payload.set('consent', data.has('consent') ? 'true' : 'false');
      payload.set('lang', form.dataset.lang ?? document.documentElement.lang);

      button?.setAttribute('disabled', '');
      sending = true;
      if (buttonLabel) buttonLabel.textContent = M.sending;
      setStatus(M.sendingStatus);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: payload,
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) {
          if (response.status === 403) {
            throw new Error(M.verifyFailed);
          }
          if (response.status === 422) {
            throw new Error(M.reviewData);
          }
          throw new Error(M.saveFailed);
        }

        form.reset();
        emailInput?.setCustomValidity('');
        submissionId = newSubmissionId();
        window.turnstile?.reset();
        setStatus(M.success, 'success');
      } catch (error) {
        window.turnstile?.reset();
        setStatus(
          error instanceof Error
            ? error.message
            : M.sendFailed,
          'error',
        );
      } finally {
        sending = false;
        button?.removeAttribute('disabled');
        if (buttonLabel) buttonLabel.textContent = M.submit;
      }
    });
  });
</script>
