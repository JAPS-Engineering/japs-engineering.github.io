---
/** HowWeHelp — the home page "¿Cómo te ayudamos?" editorial index (design 1a).
 *  Left column lists the four verbs at headline scale with the diagnóstico CTA
 *  fixed below them; each verb links to its chapter on /servicios, and hovering
 *  or focusing one previews it in the detail card on the right, and the CTA's
 *  subtitle follows the previewed service. On mobile the same rows become an
 *  accordion: tapping a verb unfolds its card right under it.
 *  Header copy is fixed brand copy for this one section, so only the step
 *  data is a prop. */
import Icon from '../ds/Icon.astro';
import Button from '../ds/Button.astro';
import HowWeHelpCard from './HowWeHelpCard.astro';
import { site } from '../../data/site';
import type { ServicioResumen } from '../../data/servicios';
import { i18n } from '../../i18n';

interface Props {
  servicios: ServicioResumen[];
}

const { servicios } = Astro.props;
const { t, p } = i18n(Astro.url);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="how-help__head">
  <div class="how-help__head-copy">
    <h2 class="section-title">{t('howHelp.title')}</h2>
    <p class="how-help__lead">{t('howHelp.lead')}</p>
  </div>
  <a class="section-link section-link--lg" href={p('services')}>{t('howHelp.link')}</a>
</div>

<div class="how-help__layout" data-editorial-index>
  <div class="how-help__aside">
    <nav class="how-help__tabs" aria-label={t('howHelp.tablist')}>
      {
        servicios.map((servicio, i) => (
          <a
            class="how-help__tab"
            href={`${p('services')}#${num(i)}`}
            aria-current={i === 0 ? 'true' : undefined}
            data-index={i}
          >
            <span class="how-help__tab-num">{num(i)}</span>
            <span class="how-help__tab-verb">{servicio.step}</span>
            <span class="how-help__tab-go" aria-hidden="true">
              <Icon name="arrow-right" size={24} />
            </span>
          </a>
        ))
      }
    </nav>

    <div class="how-help__cta">
      <span class="how-help__cta-copy">
        <span class="how-help__cta-title">{t('howHelp.ctaTitle')}</span>
        {
          servicios.map((servicio, i) => (
            <span class="how-help__cta-sub" data-index={i} hidden={i !== 0}>
              {servicio.ctaSub}
            </span>
          ))
        }
      </span>
      <span class="how-help__cta-actions">
        <Button variant="primary" href={p('contact')}>
          {t('howHelp.ctaButton')}
        </Button>
        <a
          class="how-help__whatsapp"
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          aria-label={t('howHelp.whatsapp')}
        >
          <Icon name="whatsapp" size={22} class="icon--whatsapp" />
        </a>
      </span>
    </div>
  </div>

  <div class="how-help__panels">
    {servicios.map((servicio, i) => <HowWeHelpCard servicio={servicio} num={num(i)} data-index={i} hidden={i !== 0} />)}
  </div>

  <!-- Mobile: the verb rows as an accordion, each unfolding its card. -->
  <div class="how-help-acc">
    {
      servicios.map((servicio, i) => (
        <div class="how-help-acc__item" data-index={i} data-open={i === 0 ? '' : undefined}>
          <button
            type="button"
            class="how-help__tab how-help-acc__head"
            id={`how-help-acc-head-${i}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`how-help-acc-body-${i}`}
          >
            <span class="how-help__tab-num">{num(i)}</span>
            <span class="how-help__tab-verb">{servicio.step}</span>
            <span class="how-help__tab-go" aria-hidden="true">
              <Icon name="arrow-right" size={24} />
            </span>
          </button>
          <div
            class="how-help-acc__body"
            id={`how-help-acc-body-${i}`}
            role="region"
            aria-labelledby={`how-help-acc-head-${i}`}
            inert={i !== 0}
          >
            <div class="how-help-acc__inner">
              <HowWeHelpCard servicio={servicio} num={num(i)} />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  // Row preview and the mobile accordion live in editorial-index.ts, shared
  // with the home industries.
  import { initEditorialIndex } from './editorial-index';

  initEditorialIndex();

  // Idle flourish: every few seconds (randomised per glyph so they never fire
  // in sync) each visible HowHelpMark plays its `data-idle` animation once.
  // Skipped while its host is hovered or playing — that state owns the glyph.
  // The card's watermark only follows hover/play, never idles.
  const IDLE_MS = 1600;
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGElement>('.how-help__panels .hh-mark:not(.how-help__panel-wm)').forEach((mark) => {
      const host = mark.closest('.hh-host');
      const schedule = () => {
        window.setTimeout(play, 4000 + Math.random() * 6000);
      };
      const play = () => {
        const visible = mark.getClientRects().length > 0;
        if (document.hidden || !visible || host?.matches(':hover, [data-play]')) return schedule();
        mark.setAttribute('data-idle', '');
        window.setTimeout(() => {
          mark.removeAttribute('data-idle');
          schedule();
        }, IDLE_MS);
      };
      schedule();
    });
  }
</script>
