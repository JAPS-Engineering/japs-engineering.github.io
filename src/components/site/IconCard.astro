---
/** IconCard — a Card carrying a 20px mark, a title and one line of body.
 *  `feature` swaps the hairline border for a --surface fill and 32px padding. */
import Card from '../ds/Card.astro';
import Icon from '../ds/Icon.astro';
import type { IconName } from '../ds/types';

interface Props {
  icon: IconName;
  title: string;
  text: string;
  variant?: 'base' | 'feature';
}

const { icon, title, text, variant = 'base' } = Astro.props;
---

<Card variant={variant} class="icon-card">
  <div class="icon-card__body">
    <span class="icon-card__icon"><Icon name={icon} size={20} /></span>
    <h3 class="icon-card__title">{title}</h3>
    <p class="icon-card__text">{text}</p>
  </div>
</Card>
