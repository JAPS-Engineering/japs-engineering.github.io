---
/** "Otras industrias" on the industry pages ("Páginas de industria 2a", from
 *  1a): one tone tile per remaining industry, its mark as a watermark, the
 *  tile flooding with the industry color on hover. */
import Icon from '../ds/Icon.astro';
import IndustryMark from './IndustryMark.astro';
import SectionHead from './SectionHead.astro';
import { content } from '../../data/content';
import { i18n, industryPath } from '../../i18n';

interface Props {
  /** The page's own industry (canonical ES slug), left out of the list. */
  current: string;
}

const { current } = Astro.props;
const { lang, t, p } = i18n(Astro.url);
const others = content(lang).industrias.filter((industria) => industria.slug !== current);
---

<section class="container section">
  <SectionHead title={t('industries.others')} linkLabel={t('industries.all')} href={p('industries')} />
  <div class="ind-others">
    {
      others.map((industria) => (
        <a
          class:list={['ind-other', `ind-tone--${industria.tone}`]}
          href={industryPath(industria.slug, lang)}
          data-label={t('industries.view', { name: industria.name.toLowerCase() })}
        >
          <span class="ind-other__wm" aria-hidden="true">
            <IndustryMark slug={industria.slug} size={150} stroke={1.1} variant="watermark" />
          </span>
          <span class="ind-chip ind-chip--44 ind-other__chip">
            <IndustryMark slug={industria.slug} size={24} />
          </span>
          <span class="ind-other__name">
            {industria.name}
            <Icon name="arrow-right" size={18} />
          </span>
        </a>
      ))
    }
  </div>
</section>
