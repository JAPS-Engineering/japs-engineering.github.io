      </g>
      <path
        class="page-loader__letter page-loader__letter--s"
        fill="#0F0F0F"
        d="M617.253 267.3L583.513 234.472C582.546 233.531 582 232.239 582 230.889V228H603C603 241.807 614.193 253 628 253H703.033C715.165 253 725 243.165 725 231.033C725 229.091 724.229 227.229 722.855 225.855L719.924 222.924C718.052 221.052 715.513 219.998 712.864 219.995L608.539 219.882C606.081 219.879 603.711 218.972 601.88 217.332L583.665 201.025C582.605 200.076 582 198.722 582 197.3V177.111C582 175.761 582.546 174.469 583.513 173.528L617.544 140.416C618.478 139.508 619.729 139 621.031 139H706.96C708.268 139 709.523 139.512 710.458 140.427L744.498 173.755C745.459 174.696 746 175.983 746 177.328L746 192.092L725 192V185C725 168.431 711.569 155 695 155H633C616.431 155 603 168.431 603 185V191.858C603 194.51 604.054 197.054 605.929 198.929L608.071 201.071C609.946 202.946 612.49 204 615.142 204H726.177C729.224 204 732.105 205.39 734.003 207.774L744.913 221.488C745.617 222.373 746 223.471 746 224.601V234.985C746 236.421 745.382 237.788 744.304 238.737L711.635 267.503C710.54 268.468 709.13 269 707.67 269H621.437C619.874 269 618.373 268.39 617.253 267.3Z"
      />
    </svg>
    <svg class="page-loader__icon" viewBox="62 79 176 141" fill="none" focusable="false">
      <path
        fill="black"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M68.4645 119.036L102.036 85.4645C102.973 84.5268 104.245 84 105.571 84H193.929C195.255 84 196.527 84.5268 197.464 85.4645L231.036 119.036C231.973 119.973 232.5 121.245 232.5 122.571V176.429C232.5 177.755 231.973 179.027 231.036 179.964L197.464 213.536C196.527 214.473 195.255 215 193.929 215L105.571 215C104.245 215 102.973 214.473 102.036 213.536L68.4645 179.964C67.5268 179.027 67 177.755 67 176.429L67 122.571C67 121.245 67.5268 119.973 68.4645 119.036ZM181.5 99.5H118C101.431 99.5 88 112.931 88 129.5L88 169.5C88 186.069 101.431 199.5 118 199.5H181.5C198.069 199.5 211.5 186.069 211.5 169.5V129.5C211.5 112.931 198.069 99.5 181.5 99.5Z"
      />
    </svg>
  </div>
</div>

<noscript><style is:inline>.page-loader { display: none; }</style></noscript>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: var(--canvas);
    opacity: 1;
    transition: opacity 220ms var(--motion-ease);
  }

  .page-loader.is-finished {
    opacity: 0;
    pointer-events: none;
  }

  .page-loader.is-fast,
  .page-loader.is-transitioning {
    transition-duration: 160ms;
  }

  .page-loader__brand {
    display: grid;
    place-items: center;
  }

  .page-loader__imagotipo {
    display: block;
    width: clamp(240px, 64vw, 380px);
    height: auto;
    overflow: visible;
    /* Curvas del prototipo: cuártica in-out para la escala, exponencial de salida para las letras. */
    --plm-scale-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --plm-expo-out: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .page-loader__imagotipo path {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* 0–380 ms: el isotipo crece desde su tamaño hasta el del marco. 320–440 ms: se funde con el marco. */
  .page-loader__seed {
    opacity: 0;
    animation:
      page-loader-grow 380ms var(--plm-scale-ease) both,
      page-loader-fade-out 120ms ease-out 320ms both;
  }

  .page-loader__frame {
    animation: page-loader-fade-in 80ms linear 320ms both;
  }

  /* 260–640 ms: A y P suben desde la ranura. 420–720 ms: J y S salen hacia afuera y rompen el borde. */
  .page-loader__letter--a { animation: page-loader-rise 320ms var(--plm-expo-out) 260ms both; }
  .page-loader__letter--p { animation: page-loader-rise 320ms var(--plm-expo-out) 320ms both; }

  .page-loader__letter--j,
  .page-loader__letter--s {
    animation:
      page-loader-spread 300ms var(--plm-expo-out) 420ms both,
      page-loader-fade-in 90ms linear 420ms both;
  }

  .page-loader__letter--j { --plm-dx: 110px; }
  .page-loader__letter--s { --plm-dx: -110px; }

  .page-loader__icon {
    display: none;
    width: clamp(96px, 22vw, 132px);
    height: auto;
  }

  .page-loader.is-fast .page-loader__imagotipo,
  .page-loader.is-transitioning .page-loader__imagotipo {
    display: none;
  }

  .page-loader.is-fast .page-loader__icon,
  .page-loader.is-transitioning .page-loader__icon {
    display: block;
  }

  .page-loader.is-fast .page-loader__icon {
    transform: none;
    opacity: 1;
  }

  .page-loader.is-transitioning .page-loader__icon {
    animation: page-loader-leave 160ms var(--motion-ease) both;
  }

  @keyframes page-loader-grow {
    from { transform: scale(0.3207); } /* 1 / 3,1178: el tamaño real del isotipo */
    to { transform: none; }
  }

  @keyframes page-loader-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes page-loader-fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes page-loader-rise {
    from { transform: translateY(140px); }
    to { transform: none; }
  }

  @keyframes page-loader-spread {
    from { transform: translateX(var(--plm-dx)); }
    to { transform: none; }
  }

  @keyframes page-loader-leave {
    from { transform: translateY(8px) scale(0.82); opacity: 0.35; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader { transition: none; }
    /* Sin animación cada pieza queda en su estado final: el imagotipo original, sin el isotipo extra. */
    .page-loader__imagotipo path,
    .page-loader.is-transitioning .page-loader__icon { animation: none; }
  }
</style>

<script is:inline>
(() => {
  const TRANSITION_KEY = 'japs:page-transition';
  const loader = document.querySelector('[data-page-loader]');

  if (loader) {
    let internalNavigation = false;
    try {
      internalNavigation = sessionStorage.getItem(TRANSITION_KEY) === '1';
      sessionStorage.removeItem(TRANSITION_KEY);
    } catch {
      // La navegación normal sigue funcionando si el almacenamiento está bloqueado.
    }

    const navigation = performance.getEntriesByType('navigation')[0];
    const fast = internalNavigation || navigation?.type === 'back_forward';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (fast) loader.classList.add('is-fast');

    const startedAt = performance.now();
    let finished = false;
    let navigating = false;
    let maxTimer;

    const finish = () => {
      if (finished) return;
      finished = true;
      window.clearTimeout(maxTimer);
      const minVisible = fast ? (reducedMotion ? 0 : 100) : 1000;
      const remaining = Math.max(0, minVisible - (performance.now() - startedAt));
      window.setTimeout(() => {
        loader.classList.add('is-finished');
        loader.setAttribute('aria-hidden', 'true');
      }, remaining);
    };

    maxTimer = window.setTimeout(finish, fast ? 850 : 3500);
    if (document.readyState === 'complete') {
      finish();
    } else {
      window.addEventListener('load', finish, { once: true });
    }

    document.addEventListener('click', (event) => {
      if (
        navigating || event.defaultPrevented || event.button !== 0 ||
        event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
        !(event.target instanceof Element)
      ) return;

      const link = event.target.closest('a[href]');
      if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;

      const destination = new URL(link.href, window.location.href);
      if (destination.origin !== window.location.origin || /\.[a-z0-9]+$/i.test(destination.pathname)) return;
      if (destination.pathname === window.location.pathname && destination.search === window.location.search) return;

      try {
        sessionStorage.setItem(TRANSITION_KEY, '1');
      } catch {
        return;
      }

      event.preventDefault();
      navigating = true;
      loader.classList.add('is-transitioning');
      loader.classList.remove('is-finished');
      loader.removeAttribute('aria-hidden');
      window.setTimeout(() => window.location.assign(destination.href), reducedMotion ? 0 : 180);
    });

    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      navigating = false;
      loader.classList.remove('is-transitioning');
      loader.classList.add('is-finished');
      loader.setAttribute('aria-hidden', 'true');
    });
  }
})();
</script>
