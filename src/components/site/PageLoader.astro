      />
      <!-- Isotipo centrado en el marco y escalado ×3,1178 (516 / 165,5): misma proporción que el marco. -->
      <g transform="translate(373 204) scale(3.1178) translate(-149.75 -149.5)">
        <path
          class="page-loader__seed"
          fill="#0F0F0F"
          fill-rule="evenodd"
          d="M68.4645 119.036L102.036 85.4645C102.973 84.5268 104.245 84 105.571 84H193.929C195.255 84 196.527 84.5268 197.464 85.4645L231.036 119.036C231.973 119.973 232.5 121.245 232.5 122.571V176.429C232.5 177.755 231.973 179.027 231.036 179.964L197.464 213.536C196.527 214.473 195.255 215 193.929 215L105.571 215C104.245 215 102.973 214.473 102.036 213.536L68.4645 179.964C67.5268 179.027 67 177.755 67 176.429L67 122.571C67 121.245 67.5268 119.973 68.4645 119.036ZM181.5 99.5H118C101.431 99.5 88 112.931 88 129.5L88 169.5C88 186.069 101.431 199.5 118 199.5H181.5C198.069 199.5 211.5 186.069 211.5 169.5V129.5C211.5 112.931 198.069 99.5 181.5 99.5Z"
        />
      </g>
      <path
        class="page-loader__letter page-loader__letter--j"
        fill="#0F0F0F"
        d="M164 230.889L164 139L143 139L143 223C143 239.569 129.569 253 113 253L51 253C34.4315 253 21 239.569 21 223L21 212L4.9529e-06 212L3.3116e-06 230.889C3.19431e-06 232.239 0.545764 233.531 1.51323 234.472L35.5443 267.584C36.4777 268.492 37.7287 269 39.0311 269L124.969 269C126.271 269 127.522 268.492 128.456 267.584L162.487 234.472C163.454 233.531 164 232.239 164 230.889Z"
      />
      <g clip-path="url(#page-loader-slot)">
        <path
          class="page-loader__letter page-loader__letter--a"
          fill="#0F0F0F"
          d="M194 177.111L194 269H215V185C215 168.431 228.431 155 245 155H307.003C323.571 155 337.003 168.431 337.003 185V207.057C337.003 208.32 336.604 209.551 335.864 210.574L327.697 221.862C325.817 224.461 322.803 226 319.595 226H231V244H316.509C319.366 244 322.086 242.779 323.983 240.644L328.263 235.829C331.317 232.393 337 234.553 337 239.151V269H358V177.111C358 175.761 357.454 174.469 356.487 173.528L322.456 140.416C321.522 139.508 320.271 139 318.969 139H233.031C231.729 139 230.478 139.508 229.544 140.416L195.513 173.528C194.546 174.469 194 175.761 194 177.111Z"
        />
        <path
          class="page-loader__letter page-loader__letter--p"
          fill="#0F0F0F"
          d="M388 177.111V269H409V185C409 168.431 422.431 155 439 155H501.071C517.612 155 531.032 168.388 531.071 184.929L531.112 202.545C531.122 206.718 529.826 210.79 527.406 214.19L521.99 221.799C520.114 224.435 517.079 226 513.843 226H425V244H511.016C513.574 244 516.035 243.02 517.892 241.261L550.438 210.441C551.435 209.497 552 208.184 552 206.811V177.111C552 175.761 551.454 174.469 550.487 173.528L516.456 140.416C515.522 139.508 514.271 139 512.969 139H427.031C425.729 139 424.478 139.508 423.544 140.416L389.513 173.528C388.546 174.469 388 175.761 388 177.111Z"
