---
import { i18n } from '../../i18n';

const { t } = i18n(Astro.url);
---

<!-- Imagotipo animado para la primera carga; isotipo para cambios de página.
     El imagotipo es assets/imagotipo.svg inline, con una pieza extra: el isotipo
     a escala del marco (.page-loader__seed). El isotipo crece hasta el marco, se
     funde con él y las letras salen del hueco. El último cuadro es el SVG original.
     Prototipo y variantes: ref/logo-motion-lab.html (concepto A). -->
<div class="page-loader" data-page-loader role="status" aria-label={t('a11y.loading')}>
  <div class="page-loader__brand" aria-hidden="true">
    <svg class="page-loader__imagotipo" viewBox="0 0 746 408" fill="none" focusable="false">
      <defs>
        <!-- Ranura del alto de las letras: A y P suben desde debajo de ella. -->
        <clipPath id="page-loader-slot"><rect x="181" y="137" width="384" height="134" /></clipPath>
      </defs>
      <path
        class="page-loader__frame"
        fill="#EDEDED"
        fill-rule="evenodd"
        clip-rule="evenodd"
