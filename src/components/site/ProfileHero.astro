---
/** The stadium frame, turned sideways for a person: the portrait sits in the
 *  band beside the name instead of the copy sitting centred inside it. Same
 *  32px-radius near-black band, same 48px gutter — only the alignment changes,
 *  so `hero__eyebrow`, `hero__title` and `hero__lead` are reused as they are. */
import Button from '../ds/Button.astro';
import Icon from '../ds/Icon.astro';
import ImageSlot from './ImageSlot.astro';
import ProfileGlyphs from './ProfileGlyphs.astro';
import type { Persona } from '../../data/nosotros';
import { i18n } from '../../i18n';

interface Props {
  persona: Persona;
}

const { persona } = Astro.props;
const { t, p } = i18n(Astro.url);
---

<div class="hero">
  <section class="hero__band hero__band--profile">
    <ProfileGlyphs hover={persona.hover} />
    <ImageSlot
      class="profile-hero__photo"
      placeholder={t('team.photo')}
      src={persona.photo}
      alt={persona.name}
      eager
    />

    <div class="profile-hero__body">
      <p class="hero__eyebrow">{t('team.eyebrow')}</p>
      <div class="profile-hero__name">
        <h1 class="hero__title hero__title--page">{persona.name}</h1>
        {persona.linkedin && (
          <a
            class="profile-hero__linkedin"
            href={persona.linkedin}
            target="_blank"
            rel="noopener"
            aria-label={t('team.linkedinOf', { name: persona.name })}
          >
            <Icon name="linkedin" size={20} />
          </a>
        )}
      </div>
      <div class="profile-hero__role">{persona.role}</div>
      <p class="hero__lead">{persona.lead}</p>
      <div class="hero__actions">
        {persona.email && (
          <Button variant="primary" onDark href={`mailto:${persona.email}`}>{t('team.write')}</Button>
        )}
        <Button variant="secondary" onDark href={p('about')}>{t('team.seeTeam')}</Button>
      </div>
    </div>
  </section>
</div>
