---
import Logo from '../ds/Logo.astro';
import Icon from '../ds/Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { BLOG_PATH, getPosts } from '../../data/blog';
import { content } from '../../data/content';
import { site } from '../../data/site';
import { i18n, profilePath } from '../../i18n';
import { footerIndustryLinks, footerSiteLinks, legalLinks } from '../../i18n/nav';

const { lang, t } = i18n(Astro.url);

const socialLinks = [
  { name: 'linkedin' as const, label: 'LinkedIn', href: site.linkedin },
  { name: 'instagram' as const, label: 'Instagram', href: site.instagram },
  { name: 'whatsapp' as const, label: 'WhatsApp', href: site.whatsapp },
  { name: 'mail' as const, label: t('footer.mail'), href: `mailto:${site.email}` },
];

/* Franja de sellos (rediseño C): quién nos acelera, nuestro venture studio y
   el origen. Los dos primeros enlazan afuera; Marca Chile es solo el sello. */
const seals = [
  {
    href: 'https://centrodeinnovacion.uc.cl/',
    logo: { src: '/logo/partners/ciuc-mark.svg', alt: 'Centro de Innovación UC', width: 38, height: 40 },
    title: t('footer.sealCiucTitle'),
    text: t('footer.sealCiucText'),
  },
  {
    href: site.studioUrl,
    logo: { src: '/logo/japs-studio-inverse.svg', alt: 'JAPS Studio', width: 104, height: 40 },
    title: 'JAPS Studio',
    text: t('footer.sealStudioText'),
  },
  {
    logo: { src: '/logo/partners/marca-chile.png', alt: 'Marca Chile', width: 60, height: 40 },
    title: t('footer.sealChileTitle'),
    text: t('footer.sealChileText'),
  },
];

/* JAPS-301: los socios enlazados por nombre completo desde todas las páginas,
   para que Google asocie cada nombre con su perfil en japs.ing. La lista sale
   de `isFounder`, la misma que alimenta `founder` en el JSON-LD. */
const founderLinks = content(lang)
  .equipo.filter((persona) => persona.isFounder)
  .map((persona) => ({ label: persona.name, href: `${profilePath(persona.slug, lang)}/` }));

/* JAPS-276: el blog (solo en español) aparece en el pie cuando tiene algún
   artículo visible; en producción, los borradores no cuentan. */
const hasBlog = lang === 'es' && (await getPosts()).length > 0;
const siteLinks = hasBlog
  ? [...footerSiteLinks(lang).slice(0, -1), { label: 'Blog', href: `${BLOG_PATH}/` }, ...footerSiteLinks(lang).slice(-1)]
  : footerSiteLinks(lang);

const footerSections = [
  { title: t('footer.site'), links: siteLinks },
  { title: t('footer.industries'), links: footerIndustryLinks(lang) },
  { title: t('footer.founders'), links: founderLinks },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Logo height={20} label={site.name} />
      <p class="site-footer__tagline">{t('footer.tagline')}</p>
      <div class="site-footer__social">
        {
          socialLinks.map((social) => (
            <a
              class:list={['site-footer__social-link', `site-footer__social-link--${social.name}`]}
              href={social.href}
              target={social.name === 'mail' ? undefined : '_blank'}
              rel={social.name === 'mail' ? undefined : 'noopener'}
              aria-label={social.label}
            >
              <Icon name={social.name} size={18} class={`icon--${social.name}`} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="site-footer__cols">
      {
        footerSections.map((section) => (
          <nav class="site-footer__col" aria-label={section.title}>
            <div class="site-footer__col-title">{section.title}</div>
            {section.links.map((link) => (
              <a class="site-footer__link" href={link.href}>
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }

      <nav class="site-footer__col" aria-label={t('footer.legal')}>
        <div class="site-footer__col-title">{t('footer.legal')}</div>
        {
          legalLinks(lang).map((link) => (
            <a class="site-footer__link" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="site-footer__seals">
    {
      seals.map((seal) => {
        const Tag = seal.href ? 'a' : 'div';
        return (
          <Tag
            class="site-footer__seal"
            href={seal.href}
            target={seal.href ? '_blank' : undefined}
            rel={seal.href ? 'noopener' : undefined}
          >
            <img
              class="site-footer__seal-logo"
              src={seal.logo.src}
              alt={seal.logo.alt}
              width={seal.logo.width}
              height={seal.logo.height}
              loading="lazy"
            />
            <span class="site-footer__seal-copy">
              <b>{seal.title}</b>
              {seal.text}
            </span>
          </Tag>
        );
      })
    }
  </div>

  <div class="site-footer__legal">
    <span>{t('site.copyright')}</span>
    <span>{t('site.dataNotice')}</span>
    <LangSwitch />
  </div>
</footer>
