---
import Logo from '../ds/Logo.astro';
import Icon from '../ds/Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { site } from '../../data/site';
import { i18n } from '../../i18n';
import { footerIndustryLinks, footerSiteLinks, legalLinks } from '../../i18n/nav';

const { lang, t } = i18n(Astro.url);

const socialLinks = [
  { name: 'linkedin' as const, label: 'LinkedIn', href: site.linkedin },
  { name: 'instagram' as const, label: 'Instagram', href: site.instagram },
  { name: 'whatsapp' as const, label: 'WhatsApp', href: site.whatsapp },
  { name: 'mail' as const, label: t('footer.mail'), href: `mailto:${site.email}` },
];

const footerSections = [
  { title: t('footer.site'), links: footerSiteLinks(lang) },
  { title: t('footer.industries'), links: footerIndustryLinks(lang) },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Logo height={20} label={site.name} />
      <div class="site-footer__incubator-row">
        <a
          href="https://centrodeinnovacion.uc.cl/"
          target="_blank"
          rel="noopener"
          class="site-footer__incubator"
          aria-label="Centro de Innovación UC"
        >
          <img
            src="/logo/partners/ciuc-mark.svg"
            alt="Centro de Innovación UC"
            class="site-footer__incubator-logo"
          />
        </a>
        <span class="site-footer__note">{t('footer.incubatorNote')}</span>
      </div>
      <div class="site-footer__social">
        {
          socialLinks.map((social) => (
            <a
              class:list={['site-footer__social-link', `site-footer__social-link--${social.name}`]}
              href={social.href}
              target={social.name === 'mail' ? undefined : '_blank'}
              rel={social.name === 'mail' ? undefined : 'noopener'}
              aria-label={social.label}
            >
              <Icon name={social.name} size={18} class={`icon--${social.name}`} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="site-footer__cols">
      {
        footerSections.map((section) => (
          <nav class="site-footer__col" aria-label={section.title}>
            <div class="site-footer__col-title">{section.title}</div>
            {section.links.map((link) => (
              <a class="site-footer__link" href={link.href}>
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }

      <nav class="site-footer__col" aria-label={t('footer.more')}>
        <div class="site-footer__col-title">{t('footer.more')}</div>
        <a
          class="site-footer__link site-footer__link--studio"
          href={site.studioUrl}
          target="_blank"
          rel="noopener"
        >
          JAPS Studio
        </a>
      </nav>

      <nav class="site-footer__col" aria-label={t('footer.legal')}>
        <div class="site-footer__col-title">{t('footer.legal')}</div>
        {
          legalLinks(lang).map((link) => (
            <a class="site-footer__link" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="site-footer__legal">
    <span>{t('site.copyright')}</span>
    <span>{t('site.dataNotice')}</span>
    <LangSwitch />
  </div>
</footer>
