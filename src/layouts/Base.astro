---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/sections.css';

import IconSprite from '../components/ds/IconSprite.astro';
import Seo from '../components/seo/Seo.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import WhatsAppFab from '../components/site/WhatsAppFab.astro';
import PageLoader from '../components/site/PageLoader.astro';
import type { Crumb, Node } from '../lib/schema';

interface Props {
  /** Sin sufijo de marca: Seo.astro lo añade. */
  title: string;
  description: string;
  /** Nodos JSON-LD propios de la página. */
  schema?: Node[];
  /** Miga de pan explícita, cuando la ruta no la describe bien. */
  crumbs?: Crumb[];
  /** Tarjeta social propia. Por defecto, la genérica del sitio. */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** Rutas bajo public/ a precargar — la imagen LCP de la página. */
  preloadImages?: string[];
  /** Material Symbols names used anywhere on this page — team card
   *  backgrounds, and any inline `.ms-icon` glyph. */
  iconNames?: string[];
}

const { preloadImages = [], iconNames = [], ...seo } = Astro.props;
const iconNamesParam = [...new Set(iconNames)].sort().join(',');
const iconStylesheet = `https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=${encodeURIComponent(iconNamesParam)}&display=block`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <Seo {...seo} />
    {iconNamesParam && <link rel="stylesheet" href={iconStylesheet} />}
    {
      /* El hero carga sus fotografías desde CSS, así que el navegador no las
         descubre hasta parsear la hoja de estilos. Precargar la primera
         adelanta el LCP de la página que la usa. */
      preloadImages.map((href) => <link rel="preload" as="image" href={href} />)
    }
  </head>

  <body>
    <PageLoader />
    <IconSprite />
    <SiteNav />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppFab />
  </body>
</html>
