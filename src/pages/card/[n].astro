---
import { cards, type Card } from '../../data/cards';
import Seo from '../../components/seo/Seo.astro';
import Icon from '../../components/ds/Icon.astro';
import IconSprite from '../../components/ds/IconSprite.astro';
import '../../styles/tokens.css';

export function getStaticPaths() {
  return cards.map((card) => ({ params: { n: String(card.n) }, props: { card } }));
}

interface Props { card: Card }
const { card } = Astro.props;
const title = card.kind === 'contact' ? `${card.name} · ${card.company}` : `Tarjeta ${card.n}`;
const description = card.kind === 'contact'
  ? `Guarda el contacto de ${card.name}, ${card.role} de ${card.company}: correo electrónico, teléfono y sitio web para comunicarte directamente.`
  : card.kind === 'redirect'
    ? `La tarjeta NFC ${card.n} de JAPS Engineering te conecta con nuestras soluciones de software. Continúa al destino desde esta página.`
    : `La tarjeta NFC ${card.n} de JAPS Engineering está por configurar. Su enlace estará disponible aquí cuando se le asigne un destino.`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <Seo title={title} description={description} noindex />
    {card.kind === 'redirect' && <meta http-equiv="refresh" content={`0;url=${card.href}`} />}
  </head>
  <body class:list={{ 'contact-page': card.kind === 'contact' }}>
    <IconSprite />
    <main>
      {card.kind !== 'contact' && <>
        <a href="/" aria-label="JAPS Engineering, inicio"><img src="/logo/wordmark.svg" alt="JAPS Engineering" width="180" height="40" /></a>
        <p class="eyebrow">Tarjeta {card.n}</p>
      </>}
      {card.kind === 'contact' ? (
        <>
          {card.logo && <a class="contact-brand" href={card.website} aria-label={`Sitio web de ${card.company}`}><img src={card.logo} alt={card.company} width="240" height="72" /></a>}
          {card.photo && <img class="portrait" src={card.photo} alt={card.name} width="144" height="180" />}
          <h1>{card.name}</h1>
          <p class="contact-role">{card.role} de {card.company}</p>
          <div class="contact-methods">
            <a href={`mailto:${card.email}`}><Icon name="mail" /><span><span class="contact-label">Correo</span><span>{card.email}</span></span></a>
            <a href={`tel:${card.phone}`}><Icon name="phone" /><span><span class="contact-label">Teléfono</span><span>{card.phone.replace(/^(\+56)(9)(\d{4})(\d{4})$/, '$1 $2 $3 $4')}</span></span></a>
          </div>
          <a class="action" href={card.href} download><Icon name="download" />Guardar contacto</a>
          <p class="hint">Si el contacto no se abre automáticamente, usa el botón para guardarlo.</p>
          <a class="contact-website" href={card.website}><Icon name="globe" />Sitio web de {card.company}</a>
        </>
      ) : card.kind === 'redirect' ? (
        <>
          <h1>Abriendo nuestras soluciones</h1>
          <p>Continúa con el enlace si la página no se abre automáticamente.</p>
          <a class="action" href={card.href}>Ver soluciones</a>
        </>
      ) : (
        <>
          <h1>Por configurar</h1>
          <p>Esta tarjeta aún no tiene un destino asignado.</p>
          <a class="action" href="/">Conoce JAPS Engineering</a>
        </>
      )}
    </main>
    {card.kind === 'redirect' && <script is:inline define:vars={{ destination: card.href }}>
      window.location.replace(destination);
    </script>}
    {card.kind === 'contact' && <script is:inline>
      document.querySelector('a[download]').click();
    </script>}
  </body>
</html>

<style>
  body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: var(--canvas); color: var(--ink); font-family: var(--font-sans); }
  main { box-sizing: border-box; width: min(100%, 520px); padding: 48px 24px; }
  img { object-fit: contain; object-position: left; }
  .portrait { display: block; border-radius: 16px; }
  h1 { font-size: clamp(2rem, 8vw, 3rem); line-height: 1.1; margin: 16px 0; }
  p { line-height: 1.6; }
  a { color: inherit; text-underline-offset: 4px; }
  a:focus-visible { outline: 3px solid #0066cc; outline-offset: 5px; }
  .eyebrow { margin-top: 40px; text-transform: uppercase; letter-spacing: .1em; font-size: 12px; }
  .action { display: inline-block; padding: 16px 24px; margin: 16px 0; border-radius: 12px; background: var(--ink); color: var(--canvas); font-weight: 700; text-decoration: none; }
  .hint { font-size: 14px; }
  .contact-page main { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 32px 24px; }
  .contact-brand { display: block; margin-bottom: 28px; }
  .contact-brand img { display: block; width: min(240px, 70vw); height: auto; }
  .contact-page h1 { font-size: clamp(2rem, 8vw, 2.5rem); margin: 20px 0 8px; }
  .contact-role { margin: 0 0 24px; color: #526579; }
  .contact-methods { display: grid; gap: 16px; margin-bottom: 16px; }
  .contact-methods a { display: flex; align-items: center; gap: 14px; text-align: left; text-decoration: none; }
  .contact-label { display: block; margin-bottom: 3px; font-size: 12px; color: #526579; }
  .contact-page .action { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #0066cc; }
  .contact-page .hint { max-width: 340px; margin: 0 0 20px; color: #526579; }
  .contact-website { display: inline-flex; align-items: center; gap: 8px; color: #0066cc; }
  .contact-methods a:hover, .contact-website:hover { text-decoration: underline; }
  :global(.contact-page .icon) { flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  :global(.contact-methods .icon) { color: #0066cc; }
</style>
