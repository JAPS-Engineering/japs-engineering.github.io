---
import IndustryView from '../../views/IndustryView.astro';
import { content } from '../../data/content';

export function getStaticPaths() {
  return content('es').industrias.map((industria) => ({
    params: { slug: industria.slug },
    props: { industria },
  }));
}

const { industria } = Astro.props;
---

<IndustryView industria={industria} />
