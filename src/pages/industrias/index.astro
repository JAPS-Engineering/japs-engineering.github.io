---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import PageHero from '../../components/site/PageHero.astro';
import { industrias } from '../../data/industrias';

const description =
  'Cada sector tiene sus propios cuellos de botella. Trabajamos donde ya los conocemos.';
---

<Base title="Industrias — JAPS Engineering" description={description}>
  <PageHero
    eyebrow="Industrias"
    title="Soluciones especializadas para tu industria."
    lead={description}
    titleMax={900}
    leadMax={620}
  />

  <div class="container section--mid grid-2">
    {
      industrias.map((industria, i) => (
        <a
          class:list={[
            'industry-card',
            // The fifth card has no partner in a two-up grid, so it spans both.
            i === industrias.length - 1 && industrias.length % 2 === 1 && 'industry-card--wide',
          ]}
          href={`/industrias/${industria.slug}`}
        >
          <h2 class="industry-card__title">{industria.name}</h2>
          <p class="industry-card__text">{industria.summary}</p>
          <span class="industry-card__cue">Ver soluciones →</span>
        </a>
      ))
    }
  </div>

  <CtaBand text="Si tu industria no está en la lista, igual conversemos: el método es el mismo, el dominio se aprende rápido." />
</Base>
