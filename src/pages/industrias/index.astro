---
import Base from '../../layouts/Base.astro';
import IndustryExplorer from '../../components/site/IndustryExplorer.astro';
import PageHero from '../../components/site/PageHero.astro';
import { industrias } from '../../data/industrias';

const description =
  'Cada sector tiene sus propios cuellos de botella. Trabajamos donde ya los conocemos.';

/* La meta description va aparte del `lead` del hero: el lead es copy de
   diseño y el buscador necesita una frase autocontenida que nombre quién,
   qué y dónde. Un motor generativo cita esto tal cual. */
const metaDescription =
  'JAPS Engineering desarrolla software para minería, manufactura, retail, educación superior y logística en Chile, con soluciones propias de cada sector.';
---

<Base
  title="Industrias: minería, manufactura, retail y más"
  description={metaDescription}
>
  <PageHero
    eyebrow="Industrias"
    title="Soluciones especializadas para tu industria."
    lead={description}
    titleMax={900}
    leadMax={620}
  />

  {/* The explorer closes with its own dark "¿Tu industria no está en la
      lista?" card, so this page has no CtaBand. */}
  <div class="container section--mid ind-ex-wrap">
    <IndustryExplorer industrias={industrias} />
  </div>
</Base>
