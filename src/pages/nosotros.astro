---
import Base from '../layouts/Base.astro';
import Card from '../components/ds/Card.astro';
import CtaBand from '../components/site/CtaBand.astro';
import ImageSlot from '../components/site/ImageSlot.astro';
import LogoWall from '../components/ds/LogoWall.astro';
import PageHero from '../components/site/PageHero.astro';
import PartnerCard from '../components/site/PartnerCard.astro';
import SectionHead from '../components/site/SectionHead.astro';
import TeamCard from '../components/site/TeamCard.astro';
import TeamCardBackground from '../components/site/TeamCardBackground.astro';
import {
  asesores,
  creencias,
  equipo,
  historia,
  hitosHistoria,
  iniciales,
  partnersCocreacion,
  partnersColaboracion,
  proposito,
} from '../data/nosotros';
import { personNode } from '../lib/schema';

const description =
  'La ingenieria de alto impacto y la inovación son herramientas fundamentales para el desarrollo sostenible.';

/* La meta description va aparte del `lead` del hero: el lead es copy de
   diseño y el buscador necesita una frase autocontenida que nombre quién,
   qué y dónde. Un motor generativo cita esto tal cual. */
const metaDescription =
  'Conoce a los cuatro fundadores y al equipo de JAPS Engineering: las personas detrás de sus proyectos de ingeniería e innovación.';

const heroImages = ['/hero/nosotros.jpg'];

const fundadores = equipo.filter((persona) => persona.isFounder);
const integrantes = equipo.filter((persona) => !persona.isFounder);
---

<Base
  title="Nosotros: el equipo de JAPS Engineering"
  description={metaDescription}
  schema={equipo.map(personNode)}
  iconNames={[
    ...[...equipo, ...asesores].flatMap((persona) => persona.hover?.icons ?? []),
    ...proposito.map((item) => item.icon),
    ...creencias.map((item) => item.icon),
    ...historia.map((item) => item.icon),
  ]}
>
  <PageHero
    images={heroImages}
    eyebrow="Nosotros"
    title="La ingeniería para el progreso humano."
    lead={description}
    titleMax={900}
    leadMax={640}
  />

  <section class="container section">
    <SectionHead title="Nuestro propósito" />
    <div class="stack-md">
      <div class="grid-2">
        {proposito.map((item) => (
          <Card variant="feature" title={item.eyebrow} bgIcon={item.icon} bgIconColor={item.iconColor}>
            {item.text}
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="container section">
    <SectionHead title="Nuestra filosofía" />

    <div class="grid-4">
      {creencias.map((item) => (
        <Card variant="base" icon={item.icon} iconTone={{ bg: item.chipBg, fg: item.chipFg }} title={item.title}>
          {item.text}
        </Card>
      ))}
    </div>
  </section>

  <section class="container section split">
    <div class="split__body">
      <h2 class="section-title">Nuestra historia</h2>
      <div class="history-timeline">
        {historia.map((hito) => (
          <div class="history-timeline__item">
            <div class="history-timeline__rail">
              <span class="history-timeline__chip" style={`background:${hito.chipBg};color:${hito.chipFg}`}>
                <span class="ms-icon" aria-hidden="true">{hito.icon}</span>
              </span>
              <span class="history-timeline__line" />
            </div>
            <div class="history-timeline__body">
              <span class="history-timeline__eyebrow">{hito.eyebrow}</span>
              <p class="prose">{hito.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <ImageSlot
      placeholder="Foto del equipo o del Centro de Innovación UC"
      src="/team/japs.webp"
      alt="Equipo de JAPS"
      style="height:420px"
    />
  </section>

  <div class="container section--tight">
    <LogoWall
      items={hitosHistoria}
      variant="marquee"
      eyebrow="Hitos de nuestra historia"
      logoHeight={40}
      speed={32}
    />
  </div>

  <section class="container section">
    <div class="section-intro">
      <h2 class="section-title">Nuestro equipo</h2>
      <p class="section-lead">Fundadores, equipo y asesores: las personas detrás de cada proyecto.</p>
    </div>
    <div class="team-group">
      <h3 class="team-group__title">Fundadores <span>{fundadores.length}</span></h3>
      <div class="grid-4">
        {fundadores.map((persona) => <TeamCard persona={persona} variant="founder" />)}
      </div>
    </div>
    <div class="team-group">
      <h3 class="team-group__title">Equipo <span>{integrantes.length}</span></h3>
      <div class="grid-3">
        {integrantes.map((persona) => <TeamCard persona={persona} />)}
      </div>
    </div>
    <div class="team-group">
      <h3 class="team-group__title">Asesores <span>{asesores.length}</span></h3>
      <div class="grid-4">
        {
          asesores.map((asesor, index) => (
            <div class:list={['card card--base advisor-card', { 'team-card--decorated': asesor.hover }]}>
              <TeamCardBackground id={`advisor-${index}`} hover={asesor.hover} />
              {asesor.photo ? (
                <img
                  class="advisor-card__photo"
                  src={asesor.photo}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="team-card__initials" aria-hidden="true">
                  {iniciales(asesor.name)}
                </div>
              )}
              <div>
                <div class="team-card__name">{asesor.name}</div>
                <div class="team-card__role">Asesor</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-intro">
      <h2 class="section-title">Nuestros partners</h2>
      <p class="section-lead">Con algunos construimos productos. Con otros, tecnología y ecosistema.</p>
    </div>
    <div class="team-group">
      <h3 class="team-group__title">Co-creación de producto</h3>
      <div class="grid-3">
        {partnersCocreacion.map((partner) => <PartnerCard variant="cocreacion" partner={partner} />)}
      </div>
    </div>
    <div class="team-group">
      <h3 class="team-group__title">Colaboración</h3>
      <div class="grid-4">
        {
          partnersColaboracion.map((partner) => (
            <PartnerCard variant="colaboracion" partner={partner} />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
