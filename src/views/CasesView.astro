---
/** /casos-de-exito y /en/case-studies. */
import Base from '../layouts/Base.astro';
import CaseChapter from '../components/site/CaseChapter.astro';
import CtaBand from '../components/site/CtaBand.astro';
import IndustryMark from '../components/site/IndustryMark.astro';
import PageHero from '../components/site/PageHero.astro';
import { content, industriaBySlug } from '../data/content';
import { i18n, pageCopy } from '../i18n';
import { caseNodes } from '../lib/schema';

const { lang, t } = i18n(Astro.url);
const { casos } = content(lang);

const copy = pageCopy({
  es: {
    title: 'Casos de éxito: minería, manufactura y retail',
    metaDescription:
      'Casos de éxito de JAPS Engineering: producción en Barron Vieyra, automatización comercial en AXAM y proyectos con Universidad Católica y CIUC.',
    eyebrow: 'Casos de éxito',
    heroTitle: 'Ya lo hicimos antes.',
    lead: 'Proyectos reales, con resultados operativos en manufactura, comercio y centros educativos.',
    ctaTitle: 'Tu empresa puede ser el próximo caso',
    ctaText: 'Cuéntanos tu desafío y te mostramos cómo lo abordaríamos, con números sobre la mesa.',
  },
  en: {
    title: 'Case studies: mining, manufacturing and retail',
    metaDescription:
      'JAPS Engineering case studies: production planning at Barron Vieyra, automation at AXAM, and projects with Universidad Católica and CIUC.',
    eyebrow: 'Case studies',
    heroTitle: 'We have done this before.',
    lead: 'Real projects with operational results in manufacturing, commerce and educational institutions.',
    ctaTitle: 'Your company could be the next case',
    ctaText: 'Tell us your challenge and we will show you how we would tackle it, with the numbers on the table.',
  },
});
const c = copy[lang];
---

<Base title={c.title} description={c.metaDescription} schema={caseNodes(casos, lang)}>
  <PageHero eyebrow={c.eyebrow} title={c.heroTitle} lead={c.lead} titleMax={860} leadMax={640} align="start" images={['/hero/casos-operacion-panorama.jpg']}>
    <nav class="case-index" aria-label={t('cases.indexLabel')}>
      {
        casos.map((caso, index) => (
          <a class={`ind-tone--${industriaBySlug(lang, caso.industry)!.tone}`} href={`#${caso.id}`}>
            <span class="case-index__n">{String(index + 1).padStart(2, '0')}</span>
            <span class="case-index__client">{caso.client.name}</span>
            <span class="case-index__industry">
              <IndustryMark slug={caso.industry} size={18} />
              {industriaBySlug(lang, caso.industry)!.name}
            </span>
          </a>
        ))
      }
    </nav>
  </PageHero>

  <div class="container case-chapters">
    {casos.map((caso, index) => <CaseChapter caso={caso} index={index} total={casos.length} />)}
  </div>

  <CtaBand title={c.ctaTitle} text={c.ctaText} whatsapp />
</Base>
