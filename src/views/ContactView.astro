---
/** /contacto y /en/contact — "Contacto 1a" con el hero "2b": la foto del
 *  equipo de fondo, el titular con el formato estándar de las páginas internas
 *  y los cuatro canales en una barra blanca (ContactChannels); debajo, qué pasa después y el formulario con motivo en tiles. */
import Base from '../layouts/Base.astro';
import Icon from '../components/ds/Icon.astro';
import ContactChannels from '../components/site/ContactChannels.astro';
import ContactForm from '../components/site/ContactForm.astro';
import PageHero from '../components/site/PageHero.astro';
import { contactChannelIcons, contactFormIcons } from '../data/contactOptions';
import { site } from '../data/site';
import { i18n, pageCopy } from '../i18n';
import type { Lang } from '../i18n/routes';

const { lang } = i18n(Astro.url);

const HERO_PHOTO = '/team/founders.webp';

const copy = pageCopy({
  es: {
    title: 'Contacto',
    metaDescription:
      'Conversa con JAPS Engineering sobre los desafíos tecnológicos de tu organización. Escríbenos a contacto@japs.ing o por WhatsApp: respondemos dentro de un día hábil.',
    eyebrow: 'Contacto',
    heroTitle: 'Contáctanos.',
    lead: 'Agenda una reunión para conversar los desafíos de tu organización. Respondemos dentro de un día hábil.',
    nextTitle: 'Qué pasa después',
    follow: 'Síguenos',
    formTitle: 'Envíanos un mensaje',
    formText: 'Mientras más contexto nos des, mejor preparada llega la primera conversación.',
  },
  en: {
    title: 'Contact',
    metaDescription:
      "Talk to JAPS Engineering about your organization's technology challenges. Email contacto@japs.ing or message us on WhatsApp: we reply within one business day.",
    eyebrow: 'Contact',
    heroTitle: 'Get in touch.',
    lead: "Book a meeting to talk about your organization's challenges. We reply within one business day.",
    nextTitle: 'What happens next',
    follow: 'Follow us',
    formTitle: 'Send us a message',
    formText: 'The more context you give us, the better prepared the first conversation will be.',
  },
});
const c = copy[lang];

/* Qué pasa después: [glifo Material Symbols, título, texto]. */
const STEPS: Record<Lang, [string, string, string][]> = {
  es: [
    ['edit_note', 'Nos cuentas tu desafío', 'Por el formulario, WhatsApp o correo, con el contexto que tengas.'],
    ['schedule', 'Te respondemos en un día hábil', 'Revisamos tu mensaje y te proponemos un horario.'],
    ['video_call', 'Diagnóstico gratis de 30 minutos', 'Revisamos juntos dónde la tecnología puede mover los números de tu operación.'],
  ],
  en: [
    ['edit_note', 'You tell us your challenge', 'Through the form, WhatsApp or email, with whatever context you have.'],
    ['schedule', 'We reply within one business day', 'We review your message and propose a time.'],
    ['video_call', 'Free 30-minute assessment', 'Together we look at where technology can move the numbers in your operation.'],
  ],
};
const steps = STEPS[lang];


const social = [
  { icon: 'linkedin', label: 'LinkedIn', href: site.linkedin },
  { icon: 'instagram', label: 'Instagram', href: site.instagram },
] as const;

const iconNames = [...contactChannelIcons, ...steps.map(([icon]) => icon), ...contactFormIcons];
---

<Base title={c.title} description={c.metaDescription} preloadImages={[HERO_PHOTO]} iconNames={iconNames}>
  <PageHero
    eyebrow={c.eyebrow}
    title={c.heroTitle}
    lead={c.lead}
    images={[HERO_PHOTO]}
    class="hero__band--contact"
  >
    <ContactChannels />
  </PageHero>

  <section class="container contact-page">
    <aside class="contact-page__side">
      <h2 class="contact-page__title">{c.nextTitle}</h2>
      <ol class="contact-steps">
        {
          steps.map(([icon, title, text]) => (
            <li>
              <span class="contact-steps__chip">
                <span class="ms-icon" aria-hidden="true">{icon}</span>
              </span>
              <div>
                <b>{title}</b>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="contact-social">
        <span class="contact-social__kicker">{c.follow}</span>
        <div class="contact-social__links">
          {
            social.map((s) => (
              <a class="contact-social__link" href={s.href} target="_blank" rel="noopener">
                <Icon name={s.icon} size={18} />
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </aside>

    <ContactForm variant="page" rows={5}>
      <div class="contact-form__head" slot="head">
        <h2>{c.formTitle}</h2>
        <p>{c.formText}</p>
      </div>
    </ContactForm>
  </section>
</Base>
