---
/** /industrias y /en/industries. */
import Base from '../layouts/Base.astro';
import IndustryIndex from '../components/site/IndustryIndex.astro';
import PageHero from '../components/site/PageHero.astro';
import { content } from '../data/content';
import { i18n, pageCopy } from '../i18n';

const { lang } = i18n(Astro.url);
const { industrias } = content(lang);

const copy = pageCopy({
  es: {
    title: 'Industrias: minería, manufactura, retail y más',
    metaDescription:
      'JAPS Engineering desarrolla software para minería, manufactura, retail y educación superior en Chile, con soluciones propias de cada sector.',
    eyebrow: 'Industrias',
    heroTitle: 'Soluciones especializadas para tu industria.',
    lead: 'Cada sector tiene sus propio cuellos de botella. Descubre como la tecnología puede acelerar procesos, ahorrar costos y disminuir el riesgo.',
  },
  en: {
    title: 'Industries: mining, manufacturing and retail',
    metaDescription:
      'JAPS Engineering builds software for mining, manufacturing, retail and higher education in Chile, with solutions specific to each sector.',
    eyebrow: 'Industries',
    heroTitle: 'Specialized solutions for your industry.',
    lead: 'Every sector has its own bottlenecks. Discover how technology can accelerate processes, save costs, and reduce risk.',
  },
});
const c = copy[lang];
---

<Base title={c.title} description={c.metaDescription} preloadImages={[industrias[0].heroImage]}>
  <div data-industry-hero>
    <PageHero
      eyebrow={c.eyebrow}
      title={c.heroTitle}
      lead={c.lead}
      titleMax={900}
      leadMax={620}
      images={[industrias[0].heroImage]}
    />
  </div>

  {/* The index closes with its own "¿Tu industria no está en la lista?"
      row, so this page has no CtaBand. */}
  <div class="container section--mid ind-index-wrap">
    <IndustryIndex industrias={industrias} />
  </div>
</Base>
