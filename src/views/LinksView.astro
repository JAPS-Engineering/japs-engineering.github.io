---
/**
 * /links — página estilo linktree para bio de redes sociales.
 * Traducción de Enlaces.dc.html (proyecto de diseño) a Astro, reemplazando
 * los x-import de íconos por el sprite del sitio y añadiendo un chip de
 * color por fila cuando el destino tiene una identidad de marca clara
 * (redes sociales, y los 3 productos SaaS con el mismo tono que usan en
 * /soluciones). Standalone: no usa Base/SiteNav/SiteFooter, igual que la
 * página de links de la landing anterior (legacy-v2:links.html).
 *
 * Los dominios cortos de LinkedIn/Instagram vienen de esa misma página
 * anterior — no estaban en el mockup de diseño.
 */
import '../styles/tokens.css';
import '../styles/components.css';
import IconSprite from '../components/ds/IconSprite.astro';
import Seo from '../components/seo/Seo.astro';
import Icon from '../components/ds/Icon.astro';
import LangDetect from '../components/site/LangDetect.astro';
import LangSwitch from '../components/site/LangSwitch.astro';
import type { IconName } from '../components/ds/types';
import { content } from '../data/content';
import { site } from '../data/site';
import { i18n, langTag, pageCopy } from '../i18n';

const { lang, t, p, alt } = i18n(Astro.url);
const { soluciones } = content(lang);

const copy = pageCopy({
  es: {
    title: 'Enlaces',
    description:
      'Todos los enlaces de JAPS Engineering: servicios, casos de éxito, los productos Consenty y Project Check, redes sociales y contacto directo.',
    heroEyebrow: 'Ingeniería para el progreso humano',
    heroLead: 'Ciencia, ingeniería e IA para acelerar la industria. Todos nuestros enlaces en un solo lugar.',
    whatsappTitle: 'Habla con nosotros por WhatsApp',
    whatsappSub: 'Respondemos el mismo día hábil',
    studioTitle: 'Conoce JAPS Studio',
    studioSub: 'Nuestro venture studio de triple impacto',
    company: 'Empresa',
    servicesTitle: 'Servicios',
    servicesSub: 'Explore, Build y Scale',
    casesTitle: 'Casos de éxito',
    casesSub: 'Proyectos y resultados',
    teamTitle: 'El equipo',
    teamSub: 'Quiénes somos y qué nos mueve',
    products: 'Productos',
    contactGroup: 'Contacto y redes',
    meetingTitle: 'Agenda una reunión',
    meetingSub: '30 minutos para revisar tu desafío',
    footer: '© 2026 JAPS Engineering · Centro de Innovación UC Anacleto Angelini, Santiago',
  },
  en: {
    title: 'Links',
    description:
      'All the JAPS Engineering links in one place: services, case studies, the Consenty and Project Check products, social media and direct contact.',
    heroEyebrow: 'Engineering for human progress',
    heroLead: 'Science, engineering and AI to accelerate industry. All our links in one place.',
    whatsappTitle: 'Talk to us on WhatsApp',
    whatsappSub: 'We reply the same business day',
    studioTitle: 'Discover JAPS Studio',
    studioSub: 'Our triple-impact venture studio',
    company: 'Company',
    servicesTitle: 'Services',
    servicesSub: 'Explore, Build and Scale',
    casesTitle: 'Case studies',
    casesSub: 'Projects and results',
    teamTitle: 'The team',
    teamSub: 'Who we are and what drives us',
    products: 'Products',
    contactGroup: 'Contact and social',
    meetingTitle: 'Book a meeting',
    meetingSub: '30 minutes to review your challenge',
    footer: '© 2026 JAPS Engineering · UC Anacleto Angelini Innovation Center, Santiago',
  },
});
const c = copy[lang];

interface Row {
  href: string;
  title: string;
  subtitle: string;
  icon?: IconName;
  tone?: 'neutral' | 'accent' | 'magenta' | 'blue';
  external?: boolean;
}

const empresa: Row[] = [
  { href: p('services'), title: c.servicesTitle, subtitle: c.servicesSub, icon: 'sliders-horizontal', tone: 'neutral' },
  { href: p('cases'), title: c.casesTitle, subtitle: c.casesSub, icon: 'sparkles', tone: 'accent' },
  { href: p('about'), title: c.teamTitle, subtitle: c.teamSub },
];

const productoIcon: Record<string, IconName> = { magenta: 'shield', accent: 'check', blue: 'settings' };
const productos: Row[] = soluciones.map((sol) => ({
  href: sol.href ?? p('solutions'),
  title: sol.title,
  subtitle: sol.cardText,
  icon: productoIcon[sol.tone] ?? 'sparkles',
  tone: sol.tone as Row['tone'],
  external: Boolean(sol.href),
}));

/** Mismo set e íconos que SiteFooter.astro. */
const socialLinks = [
  { name: 'linkedin' as const, label: 'LinkedIn', href: site.linkedin },
  { name: 'instagram' as const, label: 'Instagram', href: site.instagram },
  { name: 'whatsapp' as const, label: 'WhatsApp', href: site.whatsapp },
  { name: 'mail' as const, label: t('footer.mail'), href: `mailto:${site.email}` },
];
---

<!doctype html>
<html lang={langTag[lang]}>
  <head>
    <Seo title={c.title} description={c.description} lang={lang} alternate={alt} />
    <LangDetect lang={lang} alternate={alt} />
  </head>
  <body>
    <IconSprite />

    <main class="links-page">
      <div class="links-page__inner">
        <section class="links-hero">
          <img src="/logo/wordmark-inverse.svg" alt="JAPS Engineering" class="links-hero__wordmark" />
          <div class="links-hero__eyebrow">{c.heroEyebrow}</div>
          <p class="links-hero__lead">{c.heroLead}</p>
        </section>

        <a href={site.whatsapp} target="_blank" rel="noopener" class="links-cta">
          <Icon name="whatsapp" size={20} class="icon--whatsapp" />
          <span class="links-cta__text">
            <span class="links-cta__title">{c.whatsappTitle}</span>
            <span class="links-cta__subtitle">{c.whatsappSub}</span>
          </span>
          <Icon name="arrow-right" size={18} />
        </a>

        <a href="https://japs.ing" target="_blank" rel="noopener" class="links-cta links-cta--site">
          <span class="links-cta__text">
            <span class="links-cta__title">JAPS Engineering</span>
            <span class="links-cta__subtitle">japs.ing</span>
          </span>
          <Icon name="arrow-right" size={18} />
        </a>

        <a href={site.studioUrl} target="_blank" rel="noopener" class="links-cta links-cta--studio">
          <Icon name="external-link" size={20} />
          <span class="links-cta__text">
            <span class="links-cta__title">{c.studioTitle}</span>
            <span class="links-cta__subtitle">{c.studioSub}</span>
          </span>
          <Icon name="arrow-right" size={18} />
        </a>

        <div class="links-group">
          <div class="links-group__title">{c.company}</div>
          {
            empresa.map((row) => (
              <a
                href={row.href}
                class="links-row"
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener' : undefined}
              >
                {row.icon && (
                  <span class:list={['links-row__icon', `links-row__icon--${row.tone ?? 'neutral'}`]}>
                    <Icon name={row.icon} size={18} />
                  </span>
                )}
                <span class="links-row__text">
                  <span class="links-row__title">{row.title}</span>
                  <span class="links-row__subtitle">{row.subtitle}</span>
                </span>
                <Icon name={row.external ? 'external-link' : 'arrow-right'} size={18} />
              </a>
            ))
          }
        </div>

        <div class="links-group">
          <div class="links-group__title">{c.products}</div>
          {
            productos.map((row) => (
              <a href={row.href} class="links-row" target={row.external ? '_blank' : undefined} rel={row.external ? 'noopener' : undefined}>
                <span class:list={['links-row__icon', `links-row__icon--${row.tone ?? 'neutral'}`]}>
                  <Icon name={row.icon!} size={18} />
                </span>
                <span class="links-row__text">
                  <span class="links-row__title">{row.title}</span>
                  <span class="links-row__subtitle">{row.subtitle}</span>
                </span>
                <Icon name={row.external ? 'external-link' : 'arrow-right'} size={18} />
              </a>
            ))
          }
        </div>

        <div class="links-group">
          <div class="links-group__title">{c.contactGroup}</div>
          <a href={p('contact')} class="links-row">
            <span class="links-row__icon links-row__icon--neutral">
              <Icon name="message-square" size={18} />
            </span>
            <span class="links-row__text">
              <span class="links-row__title">{c.meetingTitle}</span>
              <span class="links-row__subtitle">{c.meetingSub}</span>
            </span>
            <Icon name="arrow-right" size={18} />
          </a>

          <div class="links-social">
            {
              socialLinks.map((social) => (
                <a
                  class:list={['links-social__link', `links-social__link--${social.name}`]}
                  href={social.href}
                  target={social.name === 'mail' ? undefined : '_blank'}
                  rel={social.name === 'mail' ? undefined : 'noopener'}
                  aria-label={social.label}
                >
                  <Icon name={social.name} size={18} class={`icon--${social.name}`} />
                </a>
              ))
            }
          </div>
        </div>

        <div class="links-page__footer">
          <span>{c.footer}</span>
          <LangSwitch />
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    background: var(--surface);
  }

  .links-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: var(--space-xxl) var(--space-lg) var(--space-xxxl);
  }

  .links-page__inner {
    width: 100%;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .links-hero {
    background: var(--primary);
    color: var(--on-dark);
    border-radius: var(--radius-hero);
    padding: var(--space-xxxl) var(--space-xxl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .links-hero__wordmark { height: 22px; width: auto; display: block; }

  .links-hero__eyebrow {
    font: var(--type-caption-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.7;
  }

  .links-hero__lead {
    font: var(--type-subtitle);
    opacity: 0.8;
    max-width: 380px;
  }

  .links-cta {
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius-xl);
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .links-cta--site {
    background: var(--canvas);
    color: var(--ink);
    border: 1px solid var(--border-default);
  }

  /* Tinte pálido de brand-coral (#ff5530 — ref/DESIGN-japs.md, no portado
     aún a tokens.css), con texto oscuro por ser un fondo claro. */
  .links-cta--studio { background: #ffe6de; color: var(--ink); }

  .links-cta__text { flex: 1 1 auto; display: flex; flex-direction: column; gap: 2px; }
  .links-cta__title { font: var(--type-card-title); }
  .links-cta__subtitle { font: var(--type-body-sm); opacity: 0.7; }

  .links-group { display: flex; flex-direction: column; gap: var(--space-sm); }

  .links-group__title {
    font: var(--type-caption-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-caption);
    padding: var(--space-md) var(--space-xxs) 0;
  }

  .links-row {
    background: var(--canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--ink);
    transition: border-color var(--motion-base) var(--motion-ease);
  }

  .links-row:hover { border-color: var(--border-strong); color: var(--ink); }

  .links-row__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-lg);
  }

  .links-row__icon--neutral { background: var(--surface-soft); color: var(--slate); }
  .links-row__icon--accent { background: var(--accent-soft); color: var(--accent-deep); }
  .links-row__icon--magenta { background: rgba(234, 94, 193, 0.12); color: var(--brand-magenta); }
  .links-row__icon--blue { background: var(--brand-blue-200); color: var(--brand-blue-deep); }

  .links-row__text { flex: 1 1 auto; display: flex; flex-direction: column; gap: 2px; }
  .links-row__title { font: var(--type-body-md-bold); }
  .links-row__subtitle { font: var(--type-body-sm); color: var(--text-caption); }
  .links-row__subtitle:empty { display: none; }

  /* Mismo patrón visual que .site-footer__social-link, sobre fondo claro. */
  .links-social { display: flex; justify-content: center; gap: var(--space-sm); }

  .links-social__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    color: var(--slate);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .links-social__link:hover,
  .links-social__link:focus-visible {
    color: var(--on-dark);
  }

  .links-social__link--linkedin:hover,
  .links-social__link--linkedin:focus-visible {
    border-color: #0a66c2;
    background-color: #0a66c2;
  }

  .links-social__link--instagram:hover,
  .links-social__link--instagram:focus-visible {
    border-color: #dc2743;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
  }

  .links-social__link--whatsapp:hover,
  .links-social__link--whatsapp:focus-visible {
    border-color: #25d366;
    background-color: #25d366;
  }

  .links-social__link--mail:hover,
  .links-social__link--mail:focus-visible {
    border-color: #ea4335;
    background-color: #ea4335;
  }

  .links-page__footer {
    text-align: center;
    padding: var(--space-xxl) 0 0;
    font: var(--type-caption);
    color: var(--text-caption);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  /* Sobre fondo claro el switch del footer oscuro necesita sus propios tonos. */
  .links-page__footer .lang-switch__item { color: var(--text-caption); }
  .links-page__footer .lang-switch__item:hover { color: var(--ink); border-color: var(--border-default); }
  .links-page__footer .lang-switch__item[aria-current] { color: var(--ink); }
</style>
