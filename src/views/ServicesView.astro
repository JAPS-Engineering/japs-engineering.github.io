---
/** /servicios y /en/services — editorial index (design 2a): the four verbs ride
 *  in the hero as an index, then one chapter per service with the verb on the
 *  left and the full offer on the right. Each chapter joins the catalog row
 *  (`servicios`) with its home-page summary (`serviciosResumen`) by position —
 *  the parity guard in content.ts keeps both lists aligned. */
import Base from '../layouts/Base.astro';
import Icon from '../components/ds/Icon.astro';
import CtaBand from '../components/site/CtaBand.astro';
import HowHelpMark from '../components/site/HowHelpMark.astro';
import PageHero from '../components/site/PageHero.astro';
import { content } from '../data/content';
import { i18n, pageCopy } from '../i18n';
import { serviceNodes } from '../lib/schema';

const { lang, t, p } = i18n(Astro.url);
const { servicios, serviciosResumen } = content(lang);
const chapters = servicios.map((servicio, i) => ({ ...servicio, resumen: serviciosResumen[i] }));

const copy = pageCopy({
  es: {
    title: 'Software a medida, integración y capacitación',
    metaDescription:
      'JAPS Engineering ofrece hoja de ruta digital, desarrollo de software a medida, integración de sistemas y capacitación tecnológica en Chile.',
    eyebrow: 'Servicios',
    heroTitle: 'De la estrategia al software que la ejecuta.',
    lead: 'Cuatro formas de trabajar contigo: comprender tu operación, construir soluciones, conectar sistemas y capacitar a tu equipo.',
    indexLabel: 'Servicios',
    forWhom: 'Para quién es',
    includes: 'Qué incluye',
    contactCta: 'Conversemos sobre tu equipo →',
    ctaIndustriesTitle: 'Conoce nuestras soluciones por industria',
    ctaIndustriesText:
      'Cada industria tiene sus propios desafíos. Explora cómo nuestro trabajo se adapta a tu sector.',
    ctaIndustriesLabel: 'Ver por industria →',
    ctaTalkTitle: 'Conversemos',
    ctaTalkText: 'Cuéntanos tu desafío y definamos juntos el alcance.',
    ctaTalkLabel: 'Agendar diagnóstico gratis',
  },
  en: {
    title: 'Software, integration and training services',
    metaDescription:
      'JAPS Engineering offers digital roadmaps, custom software development, systems integration and technology training in Chile.',
    eyebrow: 'Services',
    heroTitle: 'From strategy to the software that executes it.',
    lead: 'Four ways of working with you: understanding your operation, building solutions, connecting systems and training your team.',
    indexLabel: 'Services',
    forWhom: 'Who it is for',
    includes: 'What it includes',
    contactCta: "Let's talk about your team →",
    ctaIndustriesTitle: 'Explore our solutions by industry',
    ctaIndustriesText: 'Every industry has its own challenges. See how our work adapts to your sector.',
    ctaIndustriesLabel: 'Browse by industry →',
    ctaTalkTitle: "Let's talk",
    ctaTalkText: 'Tell us your challenge and let’s define the scope together.',
    ctaTalkLabel: 'Book a free assessment',
  },
});
const c = copy[lang];
---

<Base title={c.title} description={c.metaDescription} schema={serviceNodes(servicios, lang)}>
  <PageHero eyebrow={c.eyebrow} title={c.heroTitle} lead={c.lead} titleMax={860} leadMax={640} align="start" images={['/hero/servicios-estrategia.jpg']}>
    <nav class="services-index" aria-label={c.indexLabel}>
      {
        chapters.map((chapter) => (
          <a class="services-index__item" href={`#${chapter.index}`}>
            <span class="services-index__num">{chapter.index}</span>
            <span class="services-index__verb">{chapter.resumen.step}</span>
            <span class="services-index__title">{chapter.resumen.title}</span>
          </a>
        ))
      }
    </nav>
  </PageHero>

  <div class="container section--mid">
    {
      chapters.map((chapter) => (
        <article class="service-chapter hh-host" id={chapter.index}>
          <div class="service-chapter__side">
            <div class="service-chapter__head">
              <span class="service-chapter__chip">
                <HowHelpMark mark={chapter.resumen.mark} size={28} />
              </span>
              <span class="service-chapter__num">{chapter.index}</span>
            </div>
            <span class="service-chapter__verb">{chapter.resumen.step}</span>
            <div class="service-chapter__audience">
              <span class="service-chapter__kicker">{c.forWhom}</span>
              <p>{chapter.audience}</p>
              <a class="service-chapter__link" href={p(chapter.relatedCase ? 'cases' : 'contact')}>
                {chapter.relatedCase ?? c.contactCta}
              </a>
            </div>
          </div>
          <div class="service-chapter__main">
            <h2 class="service-chapter__title">{chapter.title}</h2>
            <p class="service-chapter__text">{chapter.text}</p>
            <span class="service-chapter__kicker">{c.includes}</span>
            <ul class="service-chapter__includes">
              {chapter.resumen.bullets.map((bullet) => (
                <li>
                  <Icon name="check" size={20} />
                  {bullet}
                </li>
              ))}
            </ul>
            <span class="service-chapter__kicker">{t('howHelp.deliverables')}</span>
            <ol class="service-chapter__deliverables">
              {chapter.resumen.entregables.map((entregable, j) => (
                <li>
                  <span class="service-chapter__deliverable-num">{String(j + 1).padStart(2, '0')}</span>
                  <b>{entregable.label}</b>
                  <span>{entregable.hint}</span>
                </li>
              ))}
            </ol>
          </div>
        </article>
      ))
    }

    <div class="services-industries">
      <div>
        <h2 class="services-industries__title">{c.ctaIndustriesTitle}</h2>
        <p class="services-industries__text">{c.ctaIndustriesText}</p>
      </div>
      <a class="section-link section-link--lg" href={p('industries')}>{c.ctaIndustriesLabel}</a>
    </div>
  </div>

  <CtaBand title={c.ctaTalkTitle} text={c.ctaTalkText} label={c.ctaTalkLabel} whatsapp />
</Base>
